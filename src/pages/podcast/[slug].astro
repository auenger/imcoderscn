---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const episodes = await getCollection('podcast');
  return episodes.map(episode => ({
    params: { slug: episode.slug },
    props: { episode },
  }));
}

const { episode } = Astro.props;
const { Content } = await episode.render();
---

<Layout title={`${episode.data.title} - 杨正武`}>
  <style>
    .episode-container {
      max-width: 800px;
      margin: 0 auto;
      padding: 2rem;
    }

    .episode-header {
      margin-bottom: 3rem;
      padding-bottom: 2rem;
      border-bottom: 1px solid #2a2a2a;
    }

    .episode-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      align-items: center;
      margin-bottom: 1.5rem;
    }

    .episode-date {
      color: #d4af37;
      font-size: 0.9rem;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .episode-duration {
      color: #a0a0a0;
      font-size: 0.9rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .episode-guest {
      color: #a0a0a0;
      font-size: 0.9rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .episode-tags {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
      margin-bottom: 1.5rem;
    }

    .tag {
      background: #141414;
      color: #a0a0a0;
      padding: 0.25rem 0.75rem;
      border-radius: 4px;
      font-size: 0.75rem;
      font-weight: 500;
      border: 1px solid #2a2a2a;
    }

    .episode-title {
      font-size: 2.5rem;
      font-weight: 800;
      line-height: 1.2;
      margin-bottom: 1rem;
      background: linear-gradient(135deg, #d4af37, #f5c842, #ffd700);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .episode-description {
      color: #a0a0a0;
      font-size: 1.1rem;
      line-height: 1.6;
    }

    .episode-content {
      color: #f0f0f0;
      line-height: 1.8;
      font-size: 1.05rem;
    }

    .episode-content :global(h2) {
      font-size: 1.8rem;
      font-weight: 700;
      margin-top: 3rem;
      margin-bottom: 1.5rem;
      color: #f0f0f0;
      border-left: 4px solid #d4af37;
      padding-left: 1rem;
    }

    .episode-content :global(h3) {
      font-size: 1.4rem;
      font-weight: 600;
      margin-top: 2rem;
      margin-bottom: 1rem;
      color: #f0f0f0;
    }

    .episode-content :global(p) {
      margin-bottom: 1.5rem;
    }

    .episode-content :global(strong) {
      color: #f0f0f0;
      font-weight: 600;
    }

    .episode-footer {
      margin-top: 4rem;
      padding-top: 2rem;
      border-top: 1px solid #2a2a2a;
    }

    .back-to-podcast {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      color: #d4af37;
      font-weight: 600;
      text-decoration: none;
      padding: 0.75rem 1.5rem;
      background: #1a1a1a;
      border-radius: 8px;
      border: 1px solid #2a2a2a;
      transition: all 0.3s ease;
    }

    .back-to-podcast:hover {
      border-color: #d4af37;
      transform: translateX(-3px);
    }

    .back-to-podcast i {
      transition: transform 0.3s ease;
    }

    .back-to-podcast:hover i {
      transform: translateX(-3px);
    }

    @media (max-width: 768px) {
      .episode-title {
        font-size: 2rem;
      }

      .episode-container {
        padding: 1.5rem;
      }
    }
  </style>

  <article class="episode-container">
    <header class="episode-header">
      <div class="episode-meta">
        <time class="episode-date">
          <i class="far fa-calendar"></i>
          {episode.data.pubDate.toLocaleDateString('zh-CN', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
          })}
        </time>
        {episode.data.duration && (
          <span class="episode-duration">
            <i class="far fa-clock"></i>
            {episode.data.duration}
          </span>
        )}
        {episode.data.guest && (
          <span class="episode-guest">
            <i class="far fa-user"></i>
            {episode.data.guest}
          </span>
        )}
      </div>
      <div class="episode-tags">
        {episode.data.tags.map((tag: string) => (
          <span class="tag">{tag}</span>
        ))}
      </div>
      <h1 class="episode-title">{episode.data.title}</h1>
      <p class="episode-description">{episode.data.description}</p>
    </header>

    <div class="episode-content">
      <Content />
    </div>

    <footer class="episode-footer">
      <a href="/podcast" class="back-to-podcast">
        <i class="fas fa-arrow-left"></i>
        返回播客列表
      </a>
    </footer>
  </article>
</Layout>
