---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getChapterSlug, playbooks, type PlaybookKey } from '../../../data/playbooks';

export async function getStaticPaths() {
  const entries = await getCollection('playbook');
  return entries
    .filter((entry) => !entry.data.draft)
    .map((entry) => ({
      params: { book: entry.data.book, slug: getChapterSlug(entry.slug) },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const bookKey = entry.data.book as PlaybookKey;
const book = playbooks[bookKey];
const allChapters = (await getCollection('playbook'))
  .filter((item) => !item.data.draft && item.data.book === bookKey)
  .sort((a, b) => a.data.order - b.data.order);

const currentIndex = allChapters.findIndex((item) => item.slug === entry.slug);
const previous = currentIndex > 0 ? allChapters[currentIndex - 1] : undefined;
const next = currentIndex < allChapters.length - 1 ? allChapters[currentIndex + 1] : undefined;
const { Content, headings } = await entry.render();
const chapterHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);

const parts = allChapters.reduce((groups, item) => {
  const part = item.data.part;
  if (!groups.has(part)) groups.set(part, []);
  groups.get(part)?.push(item);
  return groups;
}, new Map<string, typeof allChapters>());
---

<Layout
  title={`${entry.data.title} | ${book.title} Playbook`}
  description={entry.data.description}
  image={book.cover}
  imageWidth={book.key === 'harness' ? 720 : 1774}
  imageHeight={book.key === 'harness' ? 720 : 887}
>
  <style>
    :global(body) { background: var(--ink); }

    .reading-progress {
      position: fixed;
      z-index: 11;
      top: 71px;
      left: 0;
      width: 100%;
      height: 2px;
      background: var(--red);
      transform: scaleX(0);
      transform-origin: left;
    }

    @supports (animation-timeline: scroll()) {
      .reading-progress { animation: reading-progress linear both; animation-timeline: scroll(root); }
      @keyframes reading-progress { to { transform: scaleX(1); } }
    }

    .reader {
      width: min(100% - 64px, 1440px);
      margin-inline: auto;
      padding: 116px 0 100px;
      color: var(--text-on-ink);
    }

    .reader-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      min-height: 54px;
      margin-bottom: 34px;
      padding-bottom: 18px;
      border-bottom: 1px solid var(--line-on-ink);
    }
    .reader-home { color: var(--paper); font-family: var(--display); font-size: 1rem; letter-spacing: -0.02em; }
    .reader-home span { color: var(--red); }
    .reader-meta { color: var(--muted-on-ink); font-size: 0.78rem; }

    .reader-grid {
      display: grid;
      grid-template-columns: 250px minmax(0, 760px) 190px;
      justify-content: space-between;
      gap: clamp(34px, 4vw, 68px);
      align-items: start;
    }

    .book-index,
    .page-index {
      position: sticky;
      top: 106px;
      max-height: calc(100dvh - 132px);
      overflow-y: auto;
      scrollbar-width: thin;
      scrollbar-color: rgba(226, 60, 62, 0.5) transparent;
    }

    .index-title { margin-bottom: 22px; color: var(--paper); font-family: var(--display); font-size: 1.05rem; }
    .index-part + .index-part { margin-top: 28px; }
    .index-part h2 { margin-bottom: 10px; color: var(--red); font-size: 0.72rem; font-weight: 800; letter-spacing: 0.1em; }
    .index-part ol { margin: 0; padding: 0; list-style: none; }
    .index-part a {
      display: grid;
      grid-template-columns: 24px minmax(0, 1fr);
      gap: 8px;
      padding: 7px 8px;
      border-radius: 7px;
      color: var(--muted-on-ink);
      font-size: 0.79rem;
      line-height: 1.45;
      transition: color 160ms ease, background 160ms ease;
    }
    .index-part a:hover { color: var(--paper); background: rgba(241, 236, 226, 0.06); }
    .index-part a.is-current { color: var(--paper); background: rgba(226, 60, 62, 0.13); }
    .index-number { color: #77737d; font-variant-numeric: tabular-nums; }
    .index-part a.is-current .index-number { color: var(--red); }

    .mobile-index { display: none; margin-bottom: 28px; }
    .mobile-index details { border: 1px solid var(--line-on-ink); border-radius: 10px; background: var(--ink-soft); }
    .mobile-index summary { padding: 14px 16px; color: var(--paper); font-weight: 700; cursor: pointer; }
    .mobile-index .mobile-index-body { padding: 0 12px 14px; }

    .chapter-header { margin-bottom: 58px; padding-bottom: 44px; border-bottom: 2px solid var(--red); }
    .chapter-label { margin-bottom: 20px; color: var(--red); font-size: 0.78rem; font-weight: 800; letter-spacing: 0.1em; }
    .chapter-header h1 {
      margin-bottom: 22px;
      font-family: var(--display);
      font-size: clamp(2.8rem, 5.5vw, 5rem);
      line-height: 0.98;
      letter-spacing: -0.055em;
    }
    .chapter-description { max-width: 640px; margin-bottom: 18px; color: var(--muted-on-ink); font-size: 1.08rem; }
    .chapter-updated { margin: 0; color: #77737d; font-size: 0.78rem; }
    .chapter-source { margin-top: 8px; color: #77737d; font-size: 0.78rem; }
    .chapter-source a { color: var(--red); border-bottom: 1px solid rgba(226, 60, 62, 0.35); }

    .chapter-content { color: #cbc5bf; font-size: 1.06rem; line-height: 1.92; }
    .chapter-content :global(h2) {
      scroll-margin-top: 112px;
      margin: 3.6rem 0 1.3rem;
      color: var(--paper);
      font-family: var(--display);
      font-size: clamp(1.75rem, 3vw, 2.35rem);
      line-height: 1.15;
      letter-spacing: -0.035em;
    }
    .chapter-content :global(h3) { scroll-margin-top: 112px; margin: 2.5rem 0 1rem; color: var(--paper); font-size: 1.3rem; }
    .chapter-content :global(h4) { scroll-margin-top: 112px; margin: 2rem 0 0.8rem; color: var(--paper); font-size: 1.08rem; }
    .chapter-content :global(p) { margin-bottom: 1.45rem; }
    .chapter-content :global(ul), .chapter-content :global(ol) { margin: 0 0 1.6rem; padding-left: 1.35rem; }
    .chapter-content :global(li) { margin-bottom: 0.62rem; padding-left: 0.35rem; }
    .chapter-content :global(li::marker) { color: var(--red); }
    .chapter-content :global(a) { color: var(--red); border-bottom: 1px solid rgba(226, 60, 62, 0.35); }
    .chapter-content :global(blockquote) {
      margin: 2.4rem 0;
      padding: 20px 22px;
      border-left: 3px solid var(--red);
      border-radius: 0 10px 10px 0;
      color: var(--paper);
      background: rgba(226, 60, 62, 0.09);
    }
    .chapter-content :global(blockquote p:last-child) { margin-bottom: 0; }
    .chapter-content :global(code) {
      padding: 0.16em 0.42em;
      border-radius: 5px;
      color: #ff8b88;
      background: rgba(226, 60, 62, 0.12);
      font-family: "SFMono-Regular", Consolas, monospace;
      font-size: 0.88em;
    }
    .chapter-content :global(pre) {
      margin: 2rem 0;
      padding: 20px;
      overflow-x: auto;
      border: 1px solid var(--line-on-ink);
      border-radius: 10px;
      color: var(--paper);
      background: #0b0a0e;
    }
    .chapter-content :global(pre code) { padding: 0; color: inherit; background: transparent; }
    .chapter-content :global(table) { width: 100%; margin: 2rem 0; border-collapse: collapse; font-size: 0.9rem; }
    .chapter-content :global(th) { padding: 12px 14px; color: var(--paper); background: var(--ink-soft); border-bottom: 2px solid var(--red); text-align: left; }
    .chapter-content :global(td) { padding: 12px 14px; border-bottom: 1px solid var(--line-on-ink); vertical-align: top; }

    .chapter-nav {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
      margin-top: 76px;
      padding-top: 30px;
      border-top: 1px solid var(--line-on-ink);
    }
    .chapter-nav a {
      min-height: 116px;
      padding: 20px;
      border: 1px solid var(--line-on-ink);
      border-radius: 10px;
      transition: border-color 180ms ease, transform 180ms ease, background 180ms ease;
    }
    .chapter-nav a:hover { transform: translateY(-2px); border-color: var(--red); background: rgba(226, 60, 62, 0.06); }
    .chapter-nav a:active { transform: translateY(1px); }
    .chapter-nav .next { text-align: right; }
    .chapter-nav span { display: block; margin-bottom: 8px; color: var(--red); font-size: 0.74rem; font-weight: 800; }
    .chapter-nav strong { color: var(--paper); font-size: 0.92rem; }
    .chapter-nav-placeholder { min-height: 1px; }

    .page-index h2 { margin-bottom: 16px; color: var(--paper); font-family: var(--display); font-size: 0.95rem; }
    .page-index nav { display: grid; gap: 4px; }
    .page-index a {
      padding: 5px 0 5px 12px;
      border-left: 1px solid var(--line-on-ink);
      color: #85818a;
      font-size: 0.76rem;
      line-height: 1.45;
      transition: color 160ms ease, border-color 160ms ease;
    }
    .page-index a[data-depth="3"] { padding-left: 22px; }
    .page-index a:hover, .page-index a.is-active { color: var(--paper); border-left-color: var(--red); }

    @media (max-width: 1180px) {
      .reader-grid { grid-template-columns: 230px minmax(0, 760px); justify-content: center; }
      .page-index { display: none; }
    }

    @media (max-width: 820px) {
      .reader { width: min(100% - 32px, 760px); padding: 96px 0 72px; }
      .reading-progress { top: 63px; }
      .reader-bar { margin-bottom: 24px; }
      .reader-grid { grid-template-columns: 1fr; }
      .book-index { display: none; }
      .mobile-index { display: block; }
      .chapter-header { margin-bottom: 44px; padding-bottom: 34px; }
      .chapter-header h1 { font-size: clamp(2.5rem, 11vw, 3.75rem); }
      .chapter-content { font-size: 1rem; line-height: 1.82; }
      .chapter-content :global(table) { display: block; overflow-x: auto; white-space: nowrap; }
      .chapter-nav { grid-template-columns: 1fr; margin-top: 58px; }
      .chapter-nav-placeholder { display: none; }
    }
  </style>

  <div class="reading-progress" aria-hidden="true"></div>
  <div class="reader">
    <header class="reader-bar">
      <a class="reader-home" href={`/playbook/${bookKey}`}>{book.displayTitle} <span>PLAYBOOK</span></a>
      <span class="reader-meta">{currentIndex + 1} / {allChapters.length}</span>
    </header>

    <div class="mobile-index">
      <details>
        <summary>打开全书目录</summary>
        <div class="mobile-index-body">
          {[...parts.entries()].map(([part, items]) => (
            <section class="index-part">
              <h2>{part}</h2>
              <ol>
                {items.map((item) => (
                  <li>
                    <a href={`/playbook/${bookKey}/${getChapterSlug(item.slug)}`} class:list={{ 'is-current': item.slug === entry.slug }}>
                      <span class="index-number">{String(item.data.order).padStart(2, '0')}</span>
                      <span>{item.data.title}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </section>
          ))}
        </div>
      </details>
    </div>

    <div class="reader-grid">
      <aside class="book-index" aria-label="全书目录">
        <h2 class="index-title">全书目录</h2>
        {[...parts.entries()].map(([part, items]) => (
          <section class="index-part">
            <h2>{part}</h2>
            <ol>
              {items.map((item) => (
                <li>
                  <a href={`/playbook/${bookKey}/${getChapterSlug(item.slug)}`} class:list={{ 'is-current': item.slug === entry.slug }} aria-current={item.slug === entry.slug ? 'page' : undefined}>
                    <span class="index-number">{String(item.data.order).padStart(2, '0')}</span>
                    <span>{item.data.title}</span>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        ))}
      </aside>

      <section class="chapter-main">
        <header class="chapter-header">
          <div class="chapter-label">{entry.data.chapter} / {entry.data.part}</div>
          <h1>{entry.data.title}</h1>
          <p class="chapter-description">{entry.data.description}</p>
          <p class="chapter-updated">更新于 {entry.data.updatedAt.toLocaleDateString('zh-CN')}</p>
          {entry.data.sourceUrl && (
            <p class="chapter-source">内容来源：<a href={entry.data.sourceUrl} target="_blank" rel="noopener noreferrer">Agents-Zone/harness-engineering-playbook ↗</a></p>
          )}
        </header>

        <article class="chapter-content">
          <Content />
        </article>

        <nav class="chapter-nav" aria-label="章节导航">
          {previous ? (
            <a href={`/playbook/${bookKey}/${getChapterSlug(previous.slug)}`}>
              <span>← 上一章</span>
              <strong>{previous.data.title}</strong>
            </a>
          ) : <div class="chapter-nav-placeholder"></div>}
          {next ? (
            <a class="next" href={`/playbook/${bookKey}/${getChapterSlug(next.slug)}`}>
              <span>下一章 →</span>
              <strong>{next.data.title}</strong>
            </a>
          ) : <div class="chapter-nav-placeholder"></div>}
        </nav>
      </section>

      <aside class="page-index" aria-label="本章目录">
        <h2>本章目录</h2>
        <nav>
          {chapterHeadings.map((heading) => (
            <a href={`#${heading.slug}`} data-heading={heading.slug} data-depth={heading.depth}>{heading.text}</a>
          ))}
        </nav>
      </aside>
    </div>
  </div>

  <script>
    const headingLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-heading]'));
    const observedHeadings = headingLinks
      .map((link) => document.getElementById(link.dataset.heading || ''))
      .filter((heading): heading is HTMLElement => Boolean(heading));

    if (headingLinks.length && observedHeadings.length) {
      const activate = (id: string) => {
        headingLinks.forEach((link) => link.classList.toggle('is-active', link.dataset.heading === id));
      };
      activate(observedHeadings[0].id);
      const observer = new IntersectionObserver((entries) => {
        const visible = entries
          .filter((item) => item.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) activate((visible[0].target as HTMLElement).id);
      }, { rootMargin: '-18% 0px -68% 0px', threshold: [0, 1] });
      observedHeadings.forEach((heading) => observer.observe(heading));
    }
  </script>
</Layout>
