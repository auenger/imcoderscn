---
import Layout from '../layouts/Layout.astro';
---

<Layout title="杨正武 - Harness 工程师">
  <style>
    /* Hero 区域 */
    .hero {
      min-height: 80vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      background: linear-gradient(135deg, #0a0a0f 0%, #141414 100%);
      position: relative;
      overflow: hidden;
    }

    /* 动态背景网格 */
    .hero::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-image:
        linear-gradient(rgba(212, 175, 55, 0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(212, 175, 55, 0.03) 1px, transparent 1px);
      background-size: 50px 50px;
      animation: gridMove 20s linear infinite;
    }

    @keyframes gridMove {
      0% { transform: translate(0, 0); }
      100% { transform: translate(50px, 50px); }
    }

    .hero-content {
      position: relative;
      z-index: 10;
      padding: 2rem;
    }

    .hero-title {
      font-size: 3.5rem;
      font-weight: 800;
      margin-bottom: 1.5rem;
      letter-spacing: -0.01em;
      background: linear-gradient(135deg, #d4af37, #f5c842, #ffd700);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      animation: fadeInUp 1s ease-out;
    }

    .hero-subtitle {
      font-size: 1.25rem;
      color: #d4af37;
      font-weight: 600;
      margin-bottom: 1rem;
      letter-spacing: 0.03em;
      animation: fadeInUp 1s ease-out 0.2s;
    }

    .hero-description {
      font-size: 1.1rem;
      color: #a0a0a0;
      max-width: 650px;
      margin: 0 auto 2.5rem;
      line-height: 1.9;
      animation: fadeInUp 1s ease-out 0.4s;
    }

    .hero-description strong {
      color: #f0f0f0;
      font-weight: 600;
    }

    .hero-buttons {
      display: flex;
      gap: 1.5rem;
      justify-content: center;
      margin-top: 2rem;
      animation: fadeInUp 1s ease-out 0.6s;
    }

    .btn {
      display: inline-block;
      padding: 1rem 2.5rem;
      font-size: 1rem;
      font-weight: 600;
      border-radius: 8px;
      text-decoration: none;
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
      border: 2px solid #d4af37;
      background: transparent;
    }

    .btn-primary {
      background: linear-gradient(135deg, #d4af37, #f5c842, #ffd700);
      color: #0a0a0f;
      box-shadow: 0 4px 15px rgba(212, 175, 55, 0.3);
    }

    .btn-secondary {
      color: #f0f0f0;
    }

    .btn:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 25px rgba(212, 175, 55, 0.4);
    }

    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Section 通用样式 */
    section {
      padding: 5rem 0;
    }

    .section-title {
      font-size: 2rem;
      font-weight: 700;
      margin-bottom: 3rem;
      text-align: center;
      position: relative;
      display: inline-block;
      padding-bottom: 1rem;
    }

    .section-title::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 40px;
      height: 3px;
      background: #d4af37;
      border-radius: 2px;
    }

    /* 核心理念 */
    .philosophy-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 2rem;
      margin-bottom: 2rem;
    }

    .philosophy-card {
      background: #1a1a1a;
      border-radius: 16px;
      padding: 2.5rem 2.5rem;
      border: 1px solid #2a2a2a;
      transition: all 0.4s ease;
      position: relative;
      overflow: hidden;
    }

    .philosophy-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 4px;
      height: 100%;
      background: #d4af37;
      transition: width 0.4s ease;
    }

    .philosophy-card:hover {
      transform: translateY(-6px);
      border-color: #d4af37;
      box-shadow: rgba(0, 0, 0, 0.2);
    }

    .philosophy-card:hover::before {
      width: 6px;
    }

    .philosophy-icon {
      font-size: 2.5rem;
      color: #d4af37;
      margin-bottom: 1.25rem;
    }

    .philosophy-title {
      font-size: 1.25rem;
      font-weight: 700;
      margin-bottom: 1rem;
      color: #f0f0f0;
    }

    .philosophy-desc {
      color: #a0a0a0;
      line-height: 1.8;
    }

    /* 代表作品 */
    .projects-section {
      background: #141414;
      padding: 5rem 0;
    }

    .projects-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
      gap: 2.5rem;
      margin-bottom: 3rem;
    }

    .project-card {
      background: #1a1a1a;
      border-radius: 16px;
      padding: 2rem;
      border: 1px solid #2a2a2a;
      transition: all 0.4s ease;
      overflow: hidden;
      position: relative;
      text-decoration: none;
      display: flex;
      flex-direction: column;
      min-height: 420px;
    }

    .project-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 3px;
      background: linear-gradient(90deg, #d4af37, #f5c842);
      transform: scaleX(0);
      transition: transform 0.4s ease;
    }

    .project-card:hover {
      transform: translateY(-10px);
      border-color: #d4af37;
      box-shadow: 0 15px 40px rgba(0, 0, 0, 0.3);
    }

    .project-card:hover::before {
      transform: scaleX(1);
    }

    .project-content {
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .project-icon {
      font-size: 2rem;
      color: #d4af37;
      margin-bottom: 1.5rem;
      padding: 1.5rem;
      background: #141414;
      border-radius: 50%;
      width: 80px;
      height: 80px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1.5rem auto;
    }

    .project-title {
      font-size: 1.75rem;
      font-weight: 700;
      margin-bottom: 1rem;
      color: #f0f0f0;
      text-align: center;
    }

    .project-description {
      color: #a0a0a0;
      font-size: 0.95rem;
      line-height: 1.7;
      margin-bottom: 2rem;
      text-align: center;
    }

    .project-tech {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      margin-bottom: 2rem;
      justify-content: center;
    }

    .tech-badge {
      background: #141414;
      color: #d4af37;
      padding: 0.4rem 0.9rem;
      border-radius: 6px;
      font-size: 0.8rem;
      font-family: 'Courier New', monospace;
      font-weight: 600;
      border: 1px solid #2a2a2a;
      transition: all 0.3s ease;
    }

    .tech-badge:hover {
      background: #d4af37;
      color: #0a0a0f;
      transform: translateY(-2px);
    }

    .project-link {
      display: inline-flex;
      align-items: center;
      gap: 0.75rem;
      color: #d4af37;
      font-weight: 600;
      font-size: 0.9rem;
      transition: all 0.3s ease;
      padding: 0.75rem 1.25rem;
      background: #141414;
      border-radius: 8px;
      justify-content: flex-start;
      margin-top: auto;
    }

    .project-link i {
      transition: transform 0.3s ease;
    }

    .project-link:hover i {
      transform: translateX(3px);
    }

    /* 技术领域 */
    .skills-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 2rem;
    }

    .skill-card {
      background: #1a1a1a;
      border-radius: 16px;
      padding: 2rem;
      border: 1px solid #2a2a2a;
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
    }

    .skill-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 3px;
      background: linear-gradient(90deg, #d4af37, #f5c842);
      transform: scaleX(0);
      transition: transform 0.3s ease;
    }

    .skill-card:hover {
      transform: translateY(-6px);
      border-color: #d4af37;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    }

    .skill-card:hover::before {
      transform: scaleX(1);
    }

    .skill-icon {
      font-size: 2rem;
      color: #d4af37;
      margin-bottom: 1.5rem;
    }

    .skill-title {
      font-size: 1.25rem;
      font-weight: 700;
      margin-bottom: 1rem;
      color: #f0f0f0;
    }

    .skill-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .skill-list li {
      color: #a0a0a0;
      padding: 0.5rem 0;
      padding-left: 1.5rem;
      position: relative;
      line-height: 1.6;
    }

    .skill-list li::before {
      content: '▸';
      position: absolute;
      left: 0;
      color: #d4af37;
      font-weight: bold;
    }

    /* Playbook Section */
    .playbook-section {
      padding: 4rem 0;
      background: #141414;
    }

    .playbook-card {
      display: block;
      background: #1a1a1a;
      border: 1px solid #2a2a2a;
      border-left: 4px solid #d4af37;
      border-radius: 16px;
      padding: 3rem;
      text-decoration: none;
      transition: all 0.4s ease;
      position: relative;
      overflow: hidden;
    }

    .playbook-card::before {
      content: '';
      position: absolute;
      top: 0;
      right: 0;
      width: 200px;
      height: 200px;
      background: radial-gradient(circle, rgba(212, 175, 55, 0.06), transparent 70%);
      pointer-events: none;
    }

    .playbook-card:hover {
      transform: translateY(-4px);
      border-color: #d4af37;
      box-shadow: 0 10px 40px rgba(212, 175, 55, 0.15);
    }

    .playbook-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      color: #d4af37;
      font-size: 0.8rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-bottom: 1.25rem;
    }

    .playbook-title {
      font-size: 1.75rem;
      font-weight: 700;
      color: #f0f0f0;
      margin-bottom: 1rem;
      transition: color 0.3s ease;
    }

    .playbook-card:hover .playbook-title {
      color: #d4af37;
    }

    .playbook-desc {
      color: #a0a0a0;
      line-height: 1.8;
      max-width: 700px;
    }

    .playbook-link {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      color: #d4af37;
      font-weight: 600;
      font-size: 0.95rem;
      margin-top: 1.5rem;
      transition: gap 0.3s ease;
    }

    .playbook-card:hover .playbook-link {
      gap: 0.75rem;
    }

    /* 联系方式 */
    .contact-section {
      background: linear-gradient(135deg, #0a0a0f 0%, #141414 100%);
      padding: 5rem 0;
    }

    .contact-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 2rem;
      max-width: 800px;
      margin: 0 auto;
    }

    .contact-card {
      background: #1a1a1a;
      border-radius: 16px;
      padding: 2.5rem;
      border: 1px solid #2a2a2a;
      text-align: center;
      text-decoration: none;
      transition: all 0.3s ease;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
    }

    .contact-card:hover {
      transform: translateY(-6px);
      border-color: #d4af37;
      box-shadow: 0 10px 30px rgba(212, 175, 55, 0.2);
    }

    .contact-icon {
      font-size: 2.5rem;
      color: #d4af37;
      margin-bottom: 0.5rem;
    }

    .contact-label {
      font-size: 0.9rem;
      color: #a0a0a0;
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }

    .contact-value {
      font-size: 1.1rem;
      color: #f0f0f0;
      font-weight: 600;
    }

    /* 响应式断点 */

    /* 手机（最大宽度 640px）*/
    @media (max-width: 640px) {
      .hero-title {
        font-size: 2rem;
      }

      .hero-subtitle {
        font-size: 1rem;
      }

      .hero-description {
        font-size: 0.95rem;
      }

      .hero-buttons {
        flex-direction: column;
        gap: 1rem;
      }

      .btn {
        width: 100%;
        max-width: 280px;
        text-align: center;
      }

      /* Playbook 移动端 */
      .playbook-section {
        padding: 2.5rem 0;
      }

      .playbook-card {
        padding: 1.5rem;
      }

      .playbook-title {
        font-size: 1.25rem;
      }

      .playbook-desc {
        font-size: 0.9rem;
      }

      section {
        padding: 3rem 0;
      }

      .section-title {
        font-size: 1.5rem;
      }

      /* 核心理念 - 单列布局 */
      .philosophy-grid {
        grid-template-columns: 1fr;
        gap: 1.5rem;
      }

      .philosophy-card {
        padding: 1.5rem;
      }

      /* 代表作品 - 单列布局 */
      .projects-grid {
        grid-template-columns: 1fr;
        gap: 1.5rem;
      }

      .project-card {
        padding: 1.5rem;
        min-height: auto;
      }

      .project-icon {
        width: 60px;
        height: 60px;
        font-size: 1.5rem;
      }

      .project-title {
        font-size: 1.25rem;
      }

      .project-description {
        font-size: 0.85rem;
      }

      .tech-badge {
        font-size: 0.7rem;
        padding: 0.3rem 0.6rem;
      }

      /* 技术领域 - 单列布局 */
      .skills-grid {
        grid-template-columns: 1fr;
        gap: 1.5rem;
      }

      .skill-card {
        padding: 1.5rem;
      }

      .skill-title {
        font-size: 1.1rem;
      }

      .skill-list li {
        font-size: 0.85rem;
      }

      /* 联系方式 - 单列布局 */
      .contact-grid {
        grid-template-columns: 1fr;
        gap: 1rem;
      }

      .contact-card {
        padding: 1.5rem;
      }
    }

    /* 平板（641px - 1024px）*/
    @media (min-width: 641px) and (max-width: 1024px) {
      .hero-title {
        font-size: 2.5rem;
      }

      .hero-subtitle {
        font-size: 1.1rem;
      }

      .section-title {
        font-size: 1.75rem;
      }

      /* 核心理念 - 双列布局 */
      .philosophy-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      /* 代表作品 - 单列或双列布局 */
      .projects-grid {
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      }

      /* 技术领域 - 双列布局 */
      .skills-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      /* 联系方式 - 单列布局 */
      .contact-grid {
        grid-template-columns: 1fr;
        max-width: 400px;
      }
    }

    /* 小屏幕电脑（1025px - 1280px）*/
    @media (min-width: 1025px) and (max-width: 1280px) {
      /* 核心理念 - 三列布局 */
      .philosophy-grid {
        grid-template-columns: repeat(3, 1fr);
      }

      /* 代表作品 - 双列布局 */
      .projects-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }
  </style>

  <!-- Hero 区域 -->
  <section class="hero">
    <div class="hero-content">
      <h1 class="hero-title">Harness 工程师</h1>
      <p class="hero-subtitle">设计与 AI 智能体的高效工程实践</p>
      <p class="hero-description">
        致力于构建<strong>让 AI Agent 能够高效、可靠产出高质量代码</strong>的工程环境与系统。<br>
        从脚本化工具到多模态测试平台，将工程思维与 AI 能力深度融合。
      </p>
      <div class="hero-buttons">
        <a href="/blog" class="btn btn-primary">
          阅读博客
        </a>
        <a href="#contact" class="btn btn-secondary">
          联系我
        </a>
      </div>
    </div>
  </section>

  <!-- Harness Engineering Playbook -->
  <section class="playbook-section">
    <div class="container">
      <a href="https://agents-zone.github.io/harness-engineering-playbook/"
         target="_blank"
         rel="noopener noreferrer"
         class="playbook-card">
        <div class="playbook-badge">
          <i class="fas fa-book-open"></i>
          <span>Agents 特区社区出品</span>
        </div>
        <h2 class="playbook-title">Harness Engineering Playbook</h2>
        <p class="playbook-desc">
          实战手册：如何在团队中用 AI agent 稳定交付生产级代码。<br>
          从单个 agent 的闭环工程，到多 agent 并行扩展，再到人机协同的组织设计——三个阶段，一线实践验证的方法论。
        </p>
        <span class="playbook-link">
          <i class="fas fa-arrow-right"></i>
          在线阅读
        </span>
      </a>
    </div>
  </section>

  <!-- 核心理念 -->
  <section id="about">
    <div class="container">
      <h2 class="section-title">核心理念</h2>
      <div class="philosophy-grid">
        <div class="philosophy-card">
          <div class="philosophy-icon">
            <i class="fas fa-robot"></i>
          </div>
          <h3 class="philosophy-title">AI Agent 工程环境</h3>
          <p class="philosophy-desc">
            <strong>核心目标：让写代码不再是 AI 的唯一产出</strong><br><br>
            构建系统化的工程实践，让 AI Agent 在<strong>高效、可靠、可预测</strong>的环境中工作。
          </p>
        </div>

        <div class="philosophy-card">
          <div class="philosophy-icon">
            <i class="fas fa-terminal"></i>
          </div>
          <h3 class="philosophy-title">极简主义</h3>
          <p class="philosophy-desc">
            追求<strong>最小化工具链依赖</strong>，探索轻量化前端方案。让技术为工程服务，而非相反。
          </p>
        </div>

        <div class="philosophy-card">
          <div class="philosophy-icon">
            <i class="fas fa-mouse-pointer"></i>
          </div>
          <h3 class="philosophy-title">工程思维</h3>
          <p class="philosophy-desc">
            将复杂问题<strong>模块化、标准化、可复用</strong>，建立清晰的系统边界与职责划分。
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 代表作品 -->
  <section id="projects" class="projects-section">
    <div class="container">
      <h2 class="section-title">代表作品</h2>
      <div class="projects-grid">
        <!-- Silieco -->
        <a href="/blog/human-agent-collaboration-work-os" class="project-card">
          <div class="project-content">
            <div class="project-icon">
              <i class="fas fa-network-wired"></i>
            </div>
            <h3 class="project-title">Silieco</h3>
            <p class="project-description">
              Human + Agent Work OS<br>
              让人、Agent、Task、SOP、Skill 与 Runtime 在统一的组织空间中持续协作。
            </p>
            <div class="project-tech">
              <span class="tech-badge">Human + Agent</span>
              <span class="tech-badge">Work OS</span>
              <span class="tech-badge">Task</span>
              <span class="tech-badge">SOP</span>
            </div>
          </div>
          <div class="project-link">
            <i class="fas fa-arrow-right"></i>
            <span>阅读 Work OS 设计</span>
          </div>
        </a>

        <!-- Chat2DB Agent -->
        <a href="https://chat2db-ai.com/" target="_blank" rel="noopener noreferrer" class="project-card">
          <div class="project-content">
            <div class="project-icon">
              <i class="fas fa-database"></i>
            </div>
            <h3 class="project-title">Chat2DB Agent 化</h3>
            <p class="project-description">
              Chat2DB 开源贡献者<br>
              推动 AI 从 SQL 聊天助手升级为可调度、可审批、可恢复、可审计的 Database Agent。
            </p>
            <div class="project-tech">
              <span class="tech-badge">Open Source</span>
              <span class="tech-badge">Database Agent</span>
              <span class="tech-badge">Agent Runtime</span>
              <span class="tech-badge">Task</span>
            </div>
          </div>
          <div class="project-link">
            <i class="fas fa-external-link-alt"></i>
            <span>访问 Chat2DB 官网</span>
          </div>
        </a>

        <!-- VRT -->
        <a href="https://vrtest.cn" target="_blank" class="project-card">
          <div class="project-content">
            <div class="project-icon">
              <i class="fas fa-microchip"></i>
            </div>
            <h3 class="project-title">Visual Replay Tester</h3>
            <p class="project-description">
              下一代桌面自动化测试工具<br>
              基于 Electron + Playwright + MCP 的 AI 驱动平台。
            </p>
            <div class="project-tech">
