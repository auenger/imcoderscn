  <script>
    const heroCharacters = Array.from(document.querySelectorAll<HTMLElement>('.hero-character'));
    const heroStage = document.querySelector<HTMLElement>('.chara-stage');
    const reduceHeroMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let activeCharacter = Math.floor(Math.random() * heroCharacters.length);

    const showCharacter = (index: number) => {
      activeCharacter = index;
      heroCharacters.forEach((character, characterIndex) => character.classList.toggle('is-active', characterIndex === activeCharacter));
      heroStage?.setAttribute('aria-label', `切换雪猴角色画面，当前第 ${activeCharacter + 1} 张，共 ${heroCharacters.length} 张`);
    };

    const switchCharacter = () => {
      if (!heroStage || heroStage.classList.contains('is-switching')) return;
      if (reduceHeroMotion) {
        showCharacter((activeCharacter + 1) % heroCharacters.length);
        return;
      }
      heroStage.classList.add('is-switching');
      window.setTimeout(() => showCharacter((activeCharacter + 1) % heroCharacters.length), 240);
      window.setTimeout(() => heroStage.classList.remove('is-switching'), 640);
    };

    showCharacter(activeCharacter);
    heroStage?.addEventListener('click', switchCharacter);
    heroStage?.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter' && event.key !== ' ') return;
      event.preventDefault();
      switchCharacter();
    });

    const revealItems = document.querySelectorAll<HTMLElement>('.reveal');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (reducedMotion) {
      revealItems.forEach((item) => item.classList.add('is-visible'));
    } else {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.12 });
      revealItems.forEach((item) => observer.observe(item));
      window.addEventListener('pagehide', () => observer.disconnect(), { once: true });
    }
  </script>
