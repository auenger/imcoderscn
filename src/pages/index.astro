---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft && post.data.pubDate)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

const projects = [
  { name: 'Silieco', description: 'Human + Agent Work OS，让人、Agent、Task、SOP 与 Runtime 在统一空间中持续协作。', href: '/blog/human-agent-collaboration-work-os', meta: 'WORK OS / AGENT' },
  { name: 'Chat2DB Agent', description: '把 SQL 聊天助手升级为可调度、可审批、可恢复、可审计的 Database Agent。', href: 'https://chat2db-ai.com/', meta: 'DATABASE / OPEN SOURCE' },
  { name: 'Visual Replay Tester', description: '基于 Electron、Playwright 与 MCP 的 AI 驱动桌面自动化测试平台。', href: 'https://vrtest.cn', meta: 'TESTING / MULTIMODAL' },
  { name: 'Neuro', description: 'AI 原生桌面 IDE，用 PM Agent 串联需求拆解、编码与验收。', href: 'https://github.com/auenger/neuro-ide', meta: 'IDE / TAURI' },
  { name: 'AILock-Step', description: '基于状态锚点的 Agent 执行协议，解决跳步并支持开发过程恢复。', href: 'https://github.com/auenger/AILock-Step', meta: 'PROTOCOL / RUNTIME' },
  { name: 'Feature Workflow', description: '融合 BMad 与 OpenSpec 的特性开发工作流与工程实践。', href: 'https://github.com/auenger/AILock-Step/tree/main/feature-workflow-LockStep', meta: 'WORKFLOW / SPEC' },
  { name: 'Edith', description: '把代码转化为 AI 可消费知识的渐进式知识基础设施。', href: '/blog/edith-agent', meta: 'KNOWLEDGE / LLM' },
  { name: 'AgentsZone', description: '基于 A2A 协议的去中心化 Agent 通信与任务委派平台。', href: '/blog/agentszone', meta: 'A2A / COLLABORATION' },
  { name: 'AnyClaw', description: '多通道消息架构、Skill 约束与安全模块组成的轻量 Agent 框架。', href: 'https://github.com/auenger/anyclaw', meta: 'FRAMEWORK / SECURITY' },
];
---

<Layout
  title="杨正武 - Harness 工程师"
  description="构建让 AI Agent 高效、可靠产出高质量结果的工程环境与系统。"
  image="/site-assets/harness-monkey-hero.jpg"
  imageWidth={1024}
  imageHeight={1536}
>
  <style>
    .home { background: var(--paper); }

    .hero {
      position: relative;
      min-height: 92dvh;
      padding: 112px 0 56px;
      overflow: hidden;
      color: var(--text-on-ink);
      background:
        radial-gradient(circle at 78% 48%, rgba(226, 60, 62, 0.19), transparent 34%),
        var(--ink);
    }

    .hero::after {
      content: "HARNESS";
      position: absolute;
      left: -1.5vw;
      bottom: -0.13em;
      color: rgba(241, 236, 226, 0.035);
      font-family: var(--display);
      font-size: clamp(8rem, 24vw, 23rem);
      font-weight: 900;
      line-height: 0.8;
      letter-spacing: -0.08em;
      pointer-events: none;
    }

    .hero-grid {
      position: relative;
      z-index: 2;
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(360px, 1.1fr);
      align-items: center;
      min-height: calc(92dvh - 168px);
      gap: 20px;
    }

    .hero-copy {
      position: relative;
      z-index: 4;
      max-width: 650px;
      padding: 20px 0 54px;
    }
    .hero-kicker {
      margin-bottom: 24px;
      color: var(--red);
      font-size: 0.78rem;
      font-weight: 800;
      letter-spacing: 0.14em;
    }

    .hero h1 {
      margin-bottom: 26px;
      font-family: var(--display);
      font-size: clamp(3.5rem, 6.6vw, 7.2rem);
      line-height: 0.86;
      letter-spacing: -0.075em;
    }

    .hero h1 span { display: block; color: var(--red); }
    .hero-lead { max-width: 560px; margin-bottom: 32px; color: var(--muted-on-ink); font-size: clamp(1rem, 1.4vw, 1.18rem); }
    .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; }

    .action {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 50px;
      padding: 0 22px;
      border: 1px solid var(--line-on-ink);
      border-radius: 7px;
      color: var(--text-on-ink);
      font-size: 0.9rem;
      font-weight: 750;
      transition: transform 180ms ease, background 180ms ease, color 180ms ease;
    }

    .action.primary { color: var(--paper); background: var(--red); border-color: var(--red); }
    .action:hover { transform: translateY(-2px); }
    .action.primary:hover { background: var(--red-deep); }
    .action:active { transform: translateY(1px); }

    .hero-visual {
      position: relative;
      z-index: 1;
      align-self: end;
      height: min(76dvh, 820px);
      isolation: isolate;
    }
    .hero-visual::before {
      content: "YZW / AI ENGINEERING";
      position: absolute;
      top: 12%;
      right: -18px;
      z-index: 2;
      color: rgba(241, 236, 226, 0.56);
      font-size: 0.68rem;
      font-weight: 750;
      letter-spacing: 0.12em;
    }
    .chara-stage {
      position: relative;
      width: 100%;
      height: 100%;
      outline: none;
      cursor: pointer;
      -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 14%, #000 82%, transparent 100%);
      mask-image: linear-gradient(180deg, transparent 0%, #000 14%, #000 82%, transparent 100%);
    }
    .chara-stage:focus-visible { outline: 2px solid var(--red); outline-offset: -8px; }
    .hero-character {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: contain;
      object-position: bottom center;
      opacity: 0;
      transform: translate3d(18px, 0, 0) scale(0.985);
      filter: saturate(0.92) contrast(1.03);
      -webkit-mask-image: linear-gradient(90deg, transparent 0%, rgba(0, 0, 0, 0.38) 8%, #000 20%, #000 80%, rgba(0, 0, 0, 0.38) 92%, transparent 100%);
      mask-image: linear-gradient(90deg, transparent 0%, rgba(0, 0, 0, 0.38) 8%, #000 20%, #000 80%, rgba(0, 0, 0, 0.38) 92%, transparent 100%);
      transition: opacity 520ms cubic-bezier(.16,1,.3,1), transform 720ms cubic-bezier(.16,1,.3,1);
      pointer-events: none;
    }
    .hero-character.is-active { opacity: 1; transform: translate3d(0, 0, 0) scale(1); }
    .chara-scanline {
      position: absolute;
      z-index: 3;
      top: 8%;
      left: 10%;
      right: 6%;
      height: 2px;
      opacity: 0;
      background: linear-gradient(90deg, transparent, var(--red), rgba(241, 236, 226, 0.65), transparent);
      pointer-events: none;
    }
    .chara-stage.is-switching .chara-scanline { animation: chara-scan 620ms linear both; }
    .chara-stage.is-switching .hero-character.is-active { animation: chara-glitch 620ms steps(8, end) both; }
    .hero-orbit {
      position: absolute;
      z-index: -1;
      width: 82px;
      aspect-ratio: 1;
      right: 8%;
      top: 21%;
      border: 1px solid rgba(226, 60, 62, 0.55);
      border-radius: 50%;
      pointer-events: none;
    }
    .hero-orbit::after {
      content: "";
      position: absolute;
      width: 10px;
      aspect-ratio: 1;
      top: 2px;
      left: 13px;
      border-radius: 50%;
      background: var(--red);
    }

    .manifesto { padding: 120px 0 110px; background: var(--paper); }
    .manifesto-grid { display: grid; grid-template-columns: minmax(240px, 0.55fr) minmax(0, 1.45fr); gap: 80px; }
    .manifesto-label { color: var(--red); font-size: 0.8rem; font-weight: 800; letter-spacing: 0.12em; }
    .manifesto h2 {
      max-width: 850px;
      margin-bottom: 38px;
      font-family: var(--display);
      font-size: clamp(2.35rem, 4.7vw, 4.9rem);
      line-height: 0.98;
      letter-spacing: -0.065em;
    }
    .manifesto h2 em { color: var(--red); font-style: normal; }
    .manifesto-copy { display: grid; grid-template-columns: 1fr 1fr; gap: 36px; color: var(--muted-on-paper); }
    .manifesto-copy strong { color: var(--text-on-paper); }

    .playbook {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: end;
      gap: 32px;
      margin-top: 70px;
      padding: 34px 0 6px;
      border-top: 2px solid var(--text-on-paper);
    }
    .playbook h3 { margin-bottom: 8px; font-family: var(--display); font-size: clamp(1.8rem, 3vw, 3.3rem); letter-spacing: -0.045em; }
    .playbook p { max-width: 680px; margin-bottom: 0; color: var(--muted-on-paper); }
    .text-link { color: var(--red); font-size: 0.9rem; font-weight: 800; white-space: nowrap; }

    .projects { padding: 112px 0; color: var(--text-on-ink); background: var(--ink); }
    .section-head { margin-bottom: 48px; }
    .section-head h2 { margin-bottom: 14px; font-family: var(--display); font-size: clamp(2.65rem, 5.8vw, 6.2rem); line-height: 0.92; letter-spacing: -0.065em; }
    .section-head p { max-width: 570px; margin-bottom: 0; color: var(--muted-on-ink); }

    .featured-project {
      display: grid;
      grid-template-columns: minmax(0, 1.3fr) minmax(290px, 0.7fr);
      min-height: 540px;
      margin-bottom: 28px;
      background: var(--paper);
      color: var(--text-on-paper);
      border-radius: var(--radius);
      overflow: hidden;
    }
    .featured-project img { width: 100%; height: 100%; object-fit: cover; }
    .featured-copy { display: flex; flex-direction: column; justify-content: space-between; padding: 42px; }
    .project-meta { color: var(--red); font-size: 0.72rem; font-weight: 800; letter-spacing: 0.1em; }
    .featured-copy h3 { margin: auto 0 18px; font-family: var(--display); font-size: clamp(2.35rem, 4.3vw, 4.2rem); line-height: 0.96; letter-spacing: -0.055em; }
    .featured-copy p { color: var(--muted-on-paper); }

    .ticker-wrap {
      position: relative;
      width: 100vw;
      margin-left: calc(50% - 50vw);
      overflow: hidden;
      border-top: 1px solid var(--line-on-ink);
      border-bottom: 1px solid var(--line-on-ink);
    }
    .ticker-wrap::before,
    .ticker-wrap::after {
      content: "";
      position: absolute;
      z-index: 2;
      top: 0;
      bottom: 0;
      width: min(10vw, 140px);
      pointer-events: none;
    }
    .ticker-wrap::before { left: 0; background: linear-gradient(90deg, var(--ink), transparent); }
    .ticker-wrap::after { right: 0; background: linear-gradient(-90deg, var(--ink), transparent); }
    .ticker-track {
      display: flex;
      width: max-content;
      animation: project-ticker 42s linear infinite;
      will-change: transform;
    }
    .ticker-wrap:hover .ticker-track,
    .ticker-wrap:focus-within .ticker-track { animation-play-state: paused; }
    .ticker-group { display: flex; }
    @keyframes project-ticker { to { transform: translate3d(-50%, 0, 0); } }
    .ticker-note {
      margin: 16px 0 0;
      color: var(--muted-on-ink);
      font-size: 0.74rem;
      text-align: right;
    }
    .project-card {
      display: flex;
      flex-direction: column;
      width: clamp(280px, 27vw, 410px);
      min-height: 260px;
      padding: 30px;
      border-right: 1px solid var(--line-on-ink);
      transition: border-color 180ms ease, transform 180ms ease, background 180ms ease;
    }
    .project-card:hover { transform: translateY(-4px); background: var(--red); }
    .project-card:hover .project-meta,
    .project-card:hover p { color: var(--paper); }
    .project-card h3 { margin: auto 0 14px; font-family: var(--display); font-size: 2rem; letter-spacing: -0.045em; }
    .project-card p { margin-bottom: 0; color: var(--muted-on-ink); font-size: 0.92rem; }

    .capabilities { padding: 112px 0; background: var(--paper); }
    .capabilities .section-head h2 { color: var(--text-on-paper); }
    .capabilities .section-head p { color: var(--muted-on-paper); }
    .capability-layout { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 54px; align-items: center; }
    .capability-image {
      position: relative;
      overflow: hidden;
      aspect-ratio: 16 / 9;
      border-radius: var(--radius);
      background: var(--ink);
    }
    .capability-image img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: right center;
      transform: scale(1.9);
      transform-origin: right center;
    }
    .capability-list { display: grid; grid-template-columns: 1fr 1fr; gap: 30px 34px; }
    .capability-group { padding-top: 16px; border-top: 1px solid var(--line-on-paper); }
    .capability-group h3 { margin: 0 0 12px; color: var(--red); font-size: 1rem; }
    .capability-group ul { margin: 0; padding: 0; list-style: none; }
    .capability-group li { color: var(--muted-on-paper); font-size: 0.9rem; line-height: 1.55; }
    .capability-group li + li { margin-top: 5px; }

    .writing { padding: 110px 0; background: var(--paper-soft); }
    .writing-list { border-top: 2px solid var(--text-on-paper); }
    .writing-item { display: grid; grid-template-columns: 150px 1fr auto; gap: 28px; align-items: center; padding: 28px 0; border-bottom: 1px solid var(--line-on-paper); }
    .writing-item time { color: var(--muted-on-paper); font-size: 0.78rem; font-weight: 700; }
    .writing-item h3 { margin: 0; font-size: clamp(1.05rem, 2vw, 1.45rem); }
    .writing-item span { color: var(--red); font-weight: 800; }

    .contact { padding: 104px 0; color: var(--paper); background: var(--red); }
    .contact-inner { display: grid; grid-template-columns: 1.45fr 0.55fr; gap: 70px; align-items: end; }
    .contact h2 { margin-bottom: 20px; font-family: var(--display); font-size: clamp(2.8rem, 6.5vw, 6.5rem); line-height: 0.9; letter-spacing: -0.065em; }
    .contact p { max-width: 560px; margin-bottom: 0; color: rgba(241, 236, 226, 0.82); }
    .contact-links { display: grid; gap: 10px; }
    .contact-links a { display: flex; justify-content: space-between; gap: 20px; padding: 18px 0; border-bottom: 1px solid rgba(241, 236, 226, 0.45); font-weight: 750; }

    .reveal { opacity: 0; transform: translateY(24px); transition: opacity 600ms cubic-bezier(.16,1,.3,1), transform 600ms cubic-bezier(.16,1,.3,1); }
    .reveal.is-visible { opacity: 1; transform: translateY(0); }

    @media (max-width: 900px) {
      .hero { min-height: auto; padding-bottom: 0; }
      .hero-grid { grid-template-columns: 1fr; min-height: auto; }
      .hero-copy { padding: 40px 0 10px; }
      .hero-visual { height: 58dvh; min-height: 460px; }
      .manifesto-grid, .capability-layout { grid-template-columns: 1fr; gap: 36px; }
      .manifesto-copy { grid-template-columns: 1fr; gap: 16px; }
      .featured-project { grid-template-columns: 1fr; }
      .featured-project img { aspect-ratio: 16 / 10; }
      .featured-copy { min-height: 330px; }
      .capability-image { aspect-ratio: 16 / 8; }
      .contact-inner { grid-template-columns: 1fr; gap: 42px; }
    }

    @media (max-width: 640px) {
      .hero { padding-top: 82px; }
      .hero h1 { font-size: clamp(3.15rem, 15vw, 4.65rem); }
      .hero-visual { height: 51dvh; min-height: 390px; }
      .hero-visual::before { display: none; }
      .hero-character {
        -webkit-mask-image: linear-gradient(90deg, transparent 0%, rgba(0, 0, 0, 0.32) 7%, #000 18%, #000 82%, rgba(0, 0, 0, 0.32) 93%, transparent 100%);
        mask-image: linear-gradient(90deg, transparent 0%, rgba(0, 0, 0, 0.32) 7%, #000 18%, #000 82%, rgba(0, 0, 0, 0.32) 93%, transparent 100%);
      }
      .chara-stage {
        -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 10%, #000 84%, transparent 100%);
        mask-image: linear-gradient(180deg, transparent 0%, #000 10%, #000 84%, transparent 100%);
      }
      .manifesto, .projects, .capabilities, .writing, .contact { padding: 76px 0; }
      .manifesto-grid { gap: 24px; }
      .manifesto h2 { font-size: 2.45rem; }
      .playbook { grid-template-columns: 1fr; gap: 20px; margin-top: 50px; }
      .featured-project { min-height: 0; }
      .featured-copy { min-height: 300px; padding: 28px; }
      .project-card { width: 82vw; min-height: 240px; padding: 24px; }
      .capability-list { grid-template-columns: 1fr; gap: 22px; }
      .writing-item { grid-template-columns: 1fr auto; gap: 10px 18px; }
      .writing-item time { grid-column: 1 / -1; }
      .writing-item h3 { line-height: 1.35; }
    }

    @media (prefers-reduced-motion: no-preference) {
      .hero-copy { animation: hero-copy-in 700ms cubic-bezier(.16,1,.3,1) both; }
      .chara-stage { animation: chara-float 7.5s ease-in-out infinite; }
      .hero-orbit { animation: orbit-drift 5.5s ease-in-out infinite; }
      .hero-orbit::after { animation: orbit-pulse 2.8s ease-in-out infinite; }
    }

    @keyframes hero-copy-in {
      from { opacity: 0; transform: translate3d(0, 22px, 0); }
      to { opacity: 1; transform: translate3d(0, 0, 0); }
    }
    @keyframes orbit-drift {
      0%, 100% { transform: translate3d(0, 0, 0) rotate(0deg); }
      50% { transform: translate3d(-10px, 8px, 0) rotate(8deg); }
    }
    @keyframes orbit-pulse {
      0%, 100% { opacity: 0.5; transform: scale(0.8); }
      50% { opacity: 1; transform: scale(1.15); }
    }
    @keyframes chara-float {
      0%, 100% { transform: translate3d(0, 0, 0); }
      50% { transform: translate3d(0, -10px, 0); }
    }
    @keyframes chara-scan {
      0% { top: 8%; opacity: 0; }
      10% { opacity: 0.9; }
      78% { top: 86%; opacity: 0.75; }
      100% { top: 88%; opacity: 0; }
    }
    @keyframes chara-glitch {
      0%, 100% { clip-path: none; filter: saturate(0.92) contrast(1.03); transform: translate3d(0, 0, 0); }
      18% { clip-path: inset(8% 0 58%); filter: contrast(1.5); transform: translate3d(-7px, 2px, 0); }
      38% { clip-path: inset(52% 0 12%); filter: saturate(1.5); transform: translate3d(6px, -2px, 0); }
      62% { clip-path: inset(25% 0 34%); filter: contrast(1.8); transform: translate3d(-4px, 3px, 0); }
      82% { clip-path: none; filter: saturate(0.7); transform: translate3d(3px, 0, 0); }
    }

    @media (prefers-reduced-motion: reduce) {
      .reveal { opacity: 1; transform: none; }
      .hero-character { transition: none; }
      .ticker-wrap { overflow-x: auto; }
      .ticker-track { animation: none; will-change: auto; }
      .ticker-group[data-duplicate] { display: none; }
    }
  </style>

  <div class="home">
    <section class="hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <div class="hero-kicker">AI AGENT / ENGINEERING SYSTEMS</div>
          <h1>HARNESS <span>ENGINEER</span></h1>
          <p class="hero-lead">构建让 AI Agent 高效、可靠、可预测地完成真实工程任务的环境与系统。</p>
          <div class="hero-actions">
            <a class="action primary" href="#projects">查看作品</a>
            <a class="action" href="/blog">阅读博客</a>
          </div>
        </div>
        <div class="hero-visual hero-chara">
          <span class="hero-orbit" aria-hidden="true"></span>
          <div class="chara-stage" role="button" tabindex="0" aria-label="切换雪猴角色画面，当前第 1 张，共 3 张">
            <img class="hero-character is-active" src="/site-assets/harness-monkey-hero.jpg" alt="雪猴 AI 工程师站立并手持笔记本电脑" width="1024" height="1536" fetchpriority="high" />
            <img class="hero-character" src="/site-assets/harness-monkey-hero-action-v2.jpg" alt="雪猴 AI 工程师打开电脑进入工作状态" width="1024" height="1536" loading="eager" />
            <img class="hero-character" src="/site-assets/harness-monkey-hero-focus-v2.jpg" alt="雪猴 AI 工程师坐着专注操作终端" width="1024" height="1536" loading="eager" />
            <span class="chara-scanline" aria-hidden="true"></span>
          </div>
        </div>
      </div>
    </section>

    <section class="manifesto" id="about">
      <div class="container manifesto-grid reveal">
        <div class="manifesto-label">WHAT I BUILD</div>
        <div>
          <h2>不是让 AI 写更多代码，<em>而是让它完成工作。</em></h2>
          <div class="manifesto-copy">
            <p><strong>工程环境。</strong> 把任务、上下文、工具、测试与验收组织成稳定闭环，让 Agent 在真实系统里持续推进。</p>
            <p><strong>极简工具链。</strong> 用更少的依赖、更清晰的边界和可复用协议，把复杂能力做成可维护的工程系统。</p>
          </div>
          <a class="playbook" href="/playbook/harness">
            <div>
              <h3>Harness Engineering Playbook</h3>
              <p>从单 Agent 闭环、多 Agent 并行到人机协同组织设计，一线实践验证的方法论。</p>
            </div>
            <span class="text-link">开始阅读 →</span>
          </a>
        </div>
      </div>
    </section>

    <section class="projects" id="projects">
      <div class="container">
        <header class="section-head reveal">
          <h2>AGENT ECOSYSTEM</h2>
          <p>覆盖 Agent Runtime、工作流编排、上下文工程、MCP 工具链与自动化评测的完整技术生态。</p>
        </header>
        <a class="featured-project reveal" href={projects[0].href}>
          <img src="/site-assets/silieco-human-agent-chinese-v5.jpg" alt="工程师与 AI Agent 在中国祥云背景中围绕共享任务空间协作" width="1536" height="1024" loading="lazy" />
          <div class="featured-copy">
            <span class="project-meta">FEATURED / {projects[0].meta}</span>
            <div>
              <h3>{projects[0].name}</h3>
              <p>{projects[0].description}</p>
