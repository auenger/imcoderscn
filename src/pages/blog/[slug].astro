---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter(post => post.data.pubDate && post.data.title && post.data.description)
    .map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

// 生成分享描述（一句话，不超过50字）
const shareDescription = post.data.shareDescription ||
  post.data.description.slice(0, 50) + (post.data.description.length > 50 ? '...' : '');

// 构建分享内容
const shareUrl = `https://imcoders.cn${Astro.url.pathname}`;
const shareText = `${shareDescription}\n\n${shareUrl}`;
---

<Layout
  title={`${post.data.title} - 杨正武`}
  description={post.data.description}
  image={post.data.image}
>
  <script define:vars={{ shareText }}>
    // 分享功能
    window.shareArticle = async function() {
      try {
        await navigator.clipboard.writeText(shareText);
        // 显示成功提示
        const btn = document.querySelector('.share-button');
        if (btn) {
          const originalText = btn.innerHTML;
          btn.innerHTML = '<i class="fas fa-check"></i> 已复制';
          btn.classList.add('copied');
          setTimeout(() => {
            btn.innerHTML = originalText;
            btn.classList.remove('copied');
          }, 2000);
        }
      } catch (err) {
        console.error('复制失败:', err);
        alert('复制失败，请手动复制');
      }
    };
  </script>

  <style>
    .article-container {
      max-width: 800px;
      margin: 0 auto;
      padding: 2rem;
    }

    .article-header {
      margin-bottom: 3rem;
      padding-bottom: 2rem;
      border-bottom: 1px solid #2a2a2a;
    }

    .article-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      align-items: center;
      margin-bottom: 1.5rem;
    }

    .article-date {
      color: #e23c3e;
      font-size: 0.9rem;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .article-author {
      color: #a0a0a0;
      font-size: 0.9rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .article-tags {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    .tag {
      background: #141414;
      color: #a0a0a0;
      padding: 0.25rem 0.75rem;
      border-radius: 4px;
      font-size: 0.75rem;
      font-weight: 500;
      border: 1px solid #2a2a2a;
      transition: all 0.3s ease;
    }

    .tag:hover {
      border-color: #e23c3e;
      color: #e23c3e;
    }

    .article-title {
      font-size: 2.5rem;
      font-weight: 800;
      line-height: 1.2;
      margin-bottom: 1rem;
      background: linear-gradient(135deg, #e23c3e, #ff6b68, #d92f32);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .article-description {
      color: #a0a0a0;
      font-size: 1.1rem;
      line-height: 1.6;
    }

    .share-button {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.6rem 1.2rem;
      background: linear-gradient(135deg, #e23c3e, #ff6b68);
      color: #0a0a0f;
      border: none;
      border-radius: 8px;
      font-size: 0.9rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;
      margin-top: 1rem;
    }

    .share-button:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(226, 60, 62, 0.3);
    }

    .share-button.copied {
      background: linear-gradient(135deg, #10b981, #34d399);
    }

    .share-button i {
      font-size: 1rem;
    }

    .article-content {
      color: #f0f0f0;
      line-height: 1.8;
      font-size: 1.05rem;
    }

    .article-content :global(h2) {
      font-size: 1.8rem;
      font-weight: 700;
      margin-top: 3rem;
      margin-bottom: 1.5rem;
      color: #f0f0f0;
      border-left: 4px solid #e23c3e;
      padding-left: 1rem;
    }

    .article-content :global(h3) {
      font-size: 1.4rem;
      font-weight: 600;
      margin-top: 2rem;
      margin-bottom: 1rem;
      color: #f0f0f0;
    }

    .article-content :global(p) {
      margin-bottom: 1.5rem;
    }

    .article-content :global(a) {
      color: #e23c3e;
      text-decoration: underline;
      transition: all 0.3s ease;
    }

    .article-content :global(a:hover) {
      color: #ff6b68;
    }

    .article-content :global(code) {
      background: #141414;
      color: #e23c3e;
      padding: 0.2rem 0.5rem;
      border-radius: 4px;
      font-family: 'Courier New', monospace;
      font-size: 0.9em;
    }

    .article-content :global(pre) {
      background: #141414;
      border: 1px solid #2a2a2a;
      border-radius: 8px;
      padding: 1.5rem;
      overflow-x: auto;
      margin-bottom: 2rem;
    }

    .article-content :global(pre code) {
      background: transparent;
      padding: 0;
      color: #f0f0f0;
    }

    .article-content :global(blockquote) {
      border-left: 4px solid #e23c3e;
      padding-left: 1.5rem;
      margin: 2rem 0;
      color: #a0a0a0;
      font-style: italic;
    }

    .article-content :global(ul),
    .article-content :global(ol) {
      margin-bottom: 1.5rem;
      padding-left: 2rem;
    }

    .article-content :global(li) {
      margin-bottom: 0.75rem;
    }

    .article-content :global(table) {
      width: 100%;
      border-collapse: collapse;
      margin: 2rem 0;
      background: #1a1a1a;
      border-radius: 8px;
      overflow: hidden;
    }

    .article-content :global(th) {
      background: #141414;
      color: #e23c3e;
      padding: 1rem;
      text-align: left;
      font-weight: 600;
      border-bottom: 2px solid #2a2a2a;
    }

    .article-content :global(td) {
      padding: 1rem;
      border-bottom: 1px solid #2a2a2a;
      color: #a0a0a0;
    }

    .article-content :global(tr:last-child td) {
      border-bottom: none;
    }

    .article-content :global(img) {
      max-width: 100%;
      height: auto;
      border-radius: 8px;
      margin: 2rem 0;
    }

    .article-footer {
      margin-top: 4rem;
      padding-top: 2rem;
      border-top: 1px solid #2a2a2a;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .back-to-blog {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      color: #e23c3e;
      font-weight: 600;
      text-decoration: none;
      padding: 0.75rem 1.5rem;
      background: #1a1a1a;
      border-radius: 8px;
      border: 1px solid #2a2a2a;
      transition: all 0.3s ease;
    }

    .back-to-blog:hover {
      border-color: #e23c3e;
      transform: translateX(-3px);
    }

    .back-to-blog i {
      transition: transform 0.3s ease;
    }

    .back-to-blog:hover i {
      transform: translateX(-3px);
    }

    /* 响应式断点 */

    /* 手机（最大宽度 640px）*/
    @media (max-width: 640px) {
      .article-container {
        padding: 1rem;
      }

      .article-header {
        margin-bottom: 2rem;
        padding-bottom: 1.5rem;
      }

      .article-meta {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.5rem;
        margin-bottom: 1rem;
      }

      .article-date,
      .article-author {
        font-size: 0.8rem;
      }

      .article-tags {
        gap: 0.4rem;
        margin-bottom: 1rem;
      }

      .tag {
        font-size: 0.7rem;
        padding: 0.2rem 0.5rem;
      }

      .article-title {
        font-size: 1.75rem;
      }

      .article-description {
        font-size: 0.95rem;
      }

      .article-content {
        font-size: 1rem;
      }

      .article-content :global(h2) {
        font-size: 1.4rem;
        margin-top: 2rem;
        margin-bottom: 1rem;
      }

      .article-content :global(h3) {
        font-size: 1.2rem;
        margin-top: 1.5rem;
        margin-bottom: 0.75rem;
      }

      .article-content :global(pre) {
        padding: 1rem;
        font-size: 0.85rem;
        overflow-x: auto;
      }

      .article-content :global(table) {
        font-size: 0.85rem;
      }

      .article-content :global(td),
      .article-content :global(th) {
        padding: 0.5rem;
      }

      .article-footer {
        flex-direction: column;
        gap: 1rem;
        text-align: center;
      }
    }

    /* 平板（641px - 1024px）*/
    @media (min-width: 641px) and (max-width: 1024px) {
      .article-container {
        padding: 1.5rem;
      }

      .article-title {
        font-size: 2rem;
      }
    }
  </style>

  <style>
    :global(body) { background: var(--ink); }
    .article-container { width: min(100% - 64px, 1120px); max-width: none; padding: 136px 0 104px; }
    .article-header { margin-bottom: 70px; padding-bottom: 48px; border-bottom: 2px solid var(--red); }
    .article-meta { margin-bottom: 28px; gap: 10px 18px; }
    .article-date { color: var(--red); }
    .article-author { color: var(--muted-on-ink); }
    .article-tags { gap: 6px 12px; }
    .tag { padding: 0; color: var(--muted-on-ink); background: transparent; border: 0; border-radius: 0; }
    .tag::before { content: "#"; color: var(--red); }
    .tag:hover { color: var(--red); background: transparent; }
    .article-title {
      max-width: 980px;
      margin-bottom: 24px;
      color: var(--text-on-ink);
      background: none;
      -webkit-text-fill-color: currentColor;
      font-family: var(--display);
      font-size: clamp(2.8rem, 6vw, 5.8rem);
      line-height: 1;
      letter-spacing: -0.055em;
    }
    .article-description { max-width: 720px; color: var(--muted-on-ink); font-size: 1.12rem; }
    .share-button { color: var(--paper); background: var(--red); border-color: var(--red); border-radius: 7px; }
    .share-button:hover, .share-button.copied { color: var(--paper); background: var(--red-deep); border-color: var(--red-deep); transform: translateY(-2px); }

    .article-content { max-width: 760px; margin: 0 auto; color: var(--text-on-ink); font-size: 1.06rem; line-height: 1.9; }
    .article-content :global(p), .article-content :global(li) { color: #c9c3bd; }
    .article-content :global(h2) { margin-top: 3.2rem; color: var(--text-on-ink); border-bottom-color: var(--line-on-ink); font-family: var(--display); font-size: 2rem; letter-spacing: -0.035em; }
    .article-content :global(h3) { color: var(--text-on-ink); font-size: 1.35rem; }
    .article-content :global(a) { color: var(--red); border-color: rgba(226, 60, 62, 0.35); }
    .article-content :global(code) { color: #ff7b78; background: rgba(226, 60, 62, 0.12); }
    .article-content :global(pre) { color: var(--text-on-ink); background: #09090d; border: 1px solid var(--line-on-ink); border-radius: var(--radius); }
    .article-content :global(pre code) { color: var(--text-on-ink); }
    .article-content :global(blockquote) { color: #d7d0c9; background: rgba(226, 60, 62, 0.09); border-left-color: var(--red); }
    .article-content :global(img) { border: 0; border-radius: var(--radius); }
    .article-content :global(table) { color: var(--text-on-ink); background: var(--ink-soft); border-color: var(--line-on-ink); }
    .article-content :global(th) { color: var(--paper); background: #09090d; border-color: var(--line-on-ink); }
    .article-content :global(td) { color: #c9c3bd; border-color: var(--line-on-ink); }
    .article-footer { max-width: 760px; margin: 70px auto 0; border-top-color: var(--line-on-ink); }
    .back-to-blog { background: var(--ink-soft); border-color: var(--line-on-ink); }
    .back-to-blog { color: var(--red); }

    @media (max-width: 768px) {
      .article-container { width: min(100% - 32px, 1120px); padding: 104px 0 72px; }
      .article-header { margin-bottom: 48px; padding-bottom: 34px; }
      .article-title { font-size: clamp(2.35rem, 10.5vw, 3.6rem); }
      .article-description { font-size: 1rem; }
      .article-content { font-size: 1rem; line-height: 1.82; }
      .article-content :global(h2) { font-size: 1.65rem; }
      .article-content :global(pre) { margin-inline: -8px; border-radius: 8px; }
      .article-content :global(table) { display: block; overflow-x: auto; }
    }
  </style>

  <article class="article-container">
    <header class="article-header">
      <div class="article-meta">
        <time class="article-date">
          <i class="far fa-calendar"></i>
          {post.data.pubDate.toLocaleDateString('zh-CN', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
          })}
        </time>
        <span class="article-author">
          <i class="far fa-user"></i>
          {post.data.author}
        </span>
        <div class="article-tags">
          {post.data.tags.map((tag: string) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      </div>
      <h1 class="article-title">{post.data.title}</h1>
      <p class="article-description">{post.data.description}</p>
      <button class="share-button" onclick="shareArticle()">
        <i class="fas fa-share-alt"></i>
        分享文章
      </button>
    </header>

    <div class="article-content">
      <Content />
    </div>

    <footer class="article-footer">
      <a href="/blog" class="back-to-blog">
        <i class="fas fa-arrow-left"></i>
        返回博客列表
      </a>
    </footer>
  </article>
</Layout>
