      color: #0a0a0f;
      cursor: pointer;
      transition: all 0.2s ease;
      font-size: 0.85rem;
      font-weight: 600;
      user-select: none;
    }

    .filter-tag::after {
      content: '\00d7';
      position: absolute;
      right: 0.5rem;
      top: 50%;
      transform: translateY(-50%);
      font-size: 1.1rem;
      line-height: 1;
      font-weight: 700;
      transition: all 0.2s ease;
    }

    .filter-tag:hover {
      opacity: 0.7;
      background: #c49b30;
      border-color: #c49b30;
      transform: scale(0.95);
      box-shadow: 0 2px 8px rgba(226, 60, 62, 0.3);
    }

    .filter-tag:hover::after {
      transform: translateY(-50%) scale(1.2);
      font-weight: 800;
    }

    .filter-tag:active {
      transform: scale(0.9);
      opacity: 0.5;
    }

    .blog-content {
      max-width: 900px;
      margin: 0 auto;
      padding: 2rem;
    }

    .results-info {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1.5rem;
      padding: 1rem;
      background: #1a1a1a;
      border-radius: 8px;
      border: 1px solid #2a2a2a;
    }

    .results-count {
      color: #a0a0a0;
      font-size: 0.9rem;
    }

