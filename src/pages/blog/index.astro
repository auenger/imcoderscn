---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter(post => !post.data.draft && post.data.pubDate)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const allTags = posts.flatMap(post => post.data.tags);
const tagCounts = allTags.reduce((acc, tag) => {
  acc[tag] = (acc[tag] || 0) + 1;
  return acc;
}, {});

const uniqueTags = Object.entries(tagCounts)
  .sort((a, b) => (b[1] as number) - (a[1] as number))
  .map(([tag, count]) => ({ tag, count: count as number }));

const tagCountValues = uniqueTags.map(({ count }) => count);
const minTagCount = Math.min(...tagCountValues, 1);
const maxTagCount = Math.max(...tagCountValues, 1);

const getTagWeight = (count: number) => {
  if (maxTagCount === minTagCount) return 0.5;
  return Math.log(count / minTagCount) / Math.log(maxTagCount / minTagCount);
};
---

