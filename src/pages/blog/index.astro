<script>
  import * as THREE from 'three';
  import { CSS3DObject, CSS3DRenderer } from 'three/addons/renderers/CSS3DRenderer.js';

  const cloudRoot = document.querySelector<HTMLElement>('#tagCloud');

  if (cloudRoot && !cloudRoot.dataset.threeInitialized) {
    cloudRoot.dataset.threeInitialized = 'true';

    const tagElements = Array.from(cloudRoot.querySelectorAll<HTMLButtonElement>('.cloud-tag'));

    if (tagElements.length > 0 && window.matchMedia('(min-width: 641px)').matches) {
      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(42, 1, 1, 2000);
      const group = new THREE.Group();
      const renderer = new CSS3DRenderer();
      const objects: CSS3DObject[] = [];
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      renderer.domElement.className = 'tag-cloud-scene';
      renderer.domElement.setAttribute('aria-hidden', 'false');
      scene.add(group);
      cloudRoot.classList.add('is-three-ready');
      cloudRoot.appendChild(renderer.domElement);

      const placeTags = () => {
        const radius = Math.min(168, Math.max(118, cloudRoot.clientHeight * 0.48));
        const horizontalRadius = Math.min(radius * 1.75, cloudRoot.clientWidth * 0.36);
        const goldenAngle = Math.PI * (3 - Math.sqrt(5));

        tagElements.forEach((element, index) => {
          const y = 1 - (index / Math.max(tagElements.length - 1, 1)) * 2;
          const ringRadius = Math.sqrt(Math.max(0, 1 - y * y));
          const angle = index * goldenAngle;
          const object = new CSS3DObject(element);

          object.position.set(
            Math.cos(angle) * ringRadius * horizontalRadius,
            y * radius,
            Math.sin(angle) * ringRadius * radius,
          );
          group.add(object);
          objects.push(object);
        });
      };

      const resize = () => {
        const width = cloudRoot.clientWidth;
        const height = cloudRoot.clientHeight;
        camera.aspect = width / height;
        camera.position.z = width < 500 ? 440 : 520;
        camera.updateProjectionMatrix();
        renderer.setSize(width, height);
        renderer.render(scene, camera);
      };

      const render = () => {
        const radius = Math.min(168, Math.max(118, cloudRoot.clientHeight * 0.48));
        const worldPosition = new THREE.Vector3();

        objects.forEach((object) => {
          object.lookAt(camera.position);
          object.getWorldPosition(worldPosition);
          const depth = THREE.MathUtils.clamp((worldPosition.z + radius) / (radius * 2), 0, 1);
          object.element.style.opacity = String(0.34 + depth * 0.66);
          object.element.style.zIndex = String(Math.round(depth * 100));
        });
        renderer.render(scene, camera);
      };

      let frameId = 0;
      let isVisible = true;
      let isDragging = false;
      let didDrag = false;
      let previousX = 0;
      let previousY = 0;
      let velocityX = 0;
      let velocityY = 0.0014;

      const animate = () => {
        if (!isVisible || prefersReducedMotion.matches) return;
        frameId = window.requestAnimationFrame(animate);

        if (!isDragging) {
          velocityX *= 0.94;
          velocityY += (0.0014 - velocityY) * 0.025;
          group.rotation.x = THREE.MathUtils.clamp(group.rotation.x + velocityX, -0.55, 0.55);
          group.rotation.y += velocityY;
        }
        render();
      };

      const startAnimation = () => {
        window.cancelAnimationFrame(frameId);
        if (!prefersReducedMotion.matches && isVisible) animate();
        else render();
      };

      const onPointerDown = (event: PointerEvent) => {
        isDragging = true;
        didDrag = false;
        previousX = event.clientX;
        previousY = event.clientY;
        velocityX = 0;
        velocityY = 0;
        cloudRoot.classList.add('is-dragging');
        cloudRoot.setPointerCapture(event.pointerId);
      };

      const onPointerMove = (event: PointerEvent) => {
        if (!isDragging) return;
        const deltaX = event.clientX - previousX;
        const deltaY = event.clientY - previousY;
        if (Math.abs(deltaX) + Math.abs(deltaY) > 2) didDrag = true;
        velocityY = deltaX * 0.0035;
        velocityX = deltaY * 0.0035;
        group.rotation.y += velocityY;
        group.rotation.x = THREE.MathUtils.clamp(group.rotation.x + velocityX, -0.55, 0.55);
        previousX = event.clientX;
        previousY = event.clientY;
        render();
      };

      const onPointerUp = (event: PointerEvent) => {
        isDragging = false;
        cloudRoot.classList.remove('is-dragging');
        if (cloudRoot.hasPointerCapture(event.pointerId)) cloudRoot.releasePointerCapture(event.pointerId);
      };

      const onClickCapture = (event: MouseEvent) => {
        if (!didDrag) return;
        event.preventDefault();
        event.stopPropagation();
        didDrag = false;
      };

      const resizeObserver = new ResizeObserver(resize);
      const visibilityObserver = new IntersectionObserver(([entry]) => {
        isVisible = entry.isIntersecting;
        startAnimation();
      }, { rootMargin: '100px' });

      const cleanup = () => {
        window.cancelAnimationFrame(frameId);
        resizeObserver.disconnect();
        visibilityObserver.disconnect();
        prefersReducedMotion.removeEventListener('change', startAnimation);
        cloudRoot.removeEventListener('pointerdown', onPointerDown);
        cloudRoot.removeEventListener('pointermove', onPointerMove);
        cloudRoot.removeEventListener('pointerup', onPointerUp);
        cloudRoot.removeEventListener('pointercancel', onPointerUp);
        cloudRoot.removeEventListener('click', onClickCapture, true);
      };

      placeTags();
      resizeObserver.observe(cloudRoot);
      visibilityObserver.observe(cloudRoot);
      prefersReducedMotion.addEventListener('change', startAnimation);
      cloudRoot.addEventListener('pointerdown', onPointerDown);
      cloudRoot.addEventListener('pointermove', onPointerMove);
      cloudRoot.addEventListener('pointerup', onPointerUp);
      cloudRoot.addEventListener('pointercancel', onPointerUp);
      cloudRoot.addEventListener('click', onClickCapture, true);
      window.addEventListener('pagehide', cleanup, { once: true });
      resize();
      startAnimation();
    }
  }
</script>

<script is:inline>
  const searchInput = document.getElementById('searchInput');
  const postsList = document.getElementById('postsList');
  const emptyState = document.getElementById('emptyState');
  const resultsCount = document.getElementById('resultsCount');
  const activeFiltersContainer = document.getElementById('activeFilters');
  const clearTagsBtn = document.getElementById('clearTags');
  const tagCloud = document.getElementById('tagCloud');

  let activeTags = new Set();
  let searchQuery = '';

  function filterPosts() {
    const cards = postsList.querySelectorAll('.post-card');
    let visibleCount = 0;

    cards.forEach(card => {
      const title = card.getAttribute('data-title') || '';
      const description = card.getAttribute('data-description') || '';
      const tagList = card.getAttribute('data-tag-list') || '';
      const cardTags = tagList ? tagList.split('|||') : [];

      const matchesSearch = searchQuery === '' ||
        title.includes(searchQuery) ||
        description.includes(searchQuery) ||
        cardTags.some(tag => tag.includes(searchQuery));

      const matchesTags = activeTags.size === 0 ||
        cardTags.some(tag => activeTags.has(tag));

      const shouldShow = matchesSearch && matchesTags;

      if (shouldShow) {
        card.classList.remove('hidden');
        visibleCount++;
      } else {
        card.classList.add('hidden');
      }
    });

    resultsCount.textContent = visibleCount.toString();

    if (visibleCount === 0) {
      emptyState.classList.remove('hidden');
      postsList.classList.add('hidden');
    } else {
      emptyState.classList.add('hidden');
      postsList.classList.remove('hidden');
    }

    updateActiveFilters();
    updateTagStates();
  }

  function updateActiveFilters() {
    activeFiltersContainer.innerHTML = '';

    activeTags.forEach(tag => {
      const filterTag = document.createElement('span');
      filterTag.className = 'filter-tag';
      filterTag.setAttribute('data-tag', tag);
      filterTag.textContent = tag;
      activeFiltersContainer.appendChild(filterTag);
    });

    if (activeTags.size > 0) {
      clearTagsBtn.classList.add('visible');
    } else {
      clearTagsBtn.classList.remove('visible');
    }
  }

  function updateTagStates() {
    document.querySelectorAll('.cloud-tag, .tag').forEach(tagEl => {
      const tag = tagEl.getAttribute('data-tag');
      if (tag && activeTags.has(tag.toLowerCase())) {
        tagEl.classList.add('active');
        if (tagEl.classList.contains('cloud-tag')) tagEl.setAttribute('aria-pressed', 'true');
      } else {
        tagEl.classList.remove('active');
        if (tagEl.classList.contains('cloud-tag')) tagEl.setAttribute('aria-pressed', 'false');
      }
    });
  }

  function toggleTag(tag) {
    const normalizedTag = tag.toLowerCase();
    if (activeTags.has(normalizedTag)) {
      activeTags.delete(normalizedTag);
    } else {
      activeTags.add(normalizedTag);
    }
    filterPosts();
  }

  function clearAllTags() {
    activeTags.clear();
    filterPosts();
  }

  searchInput?.addEventListener('input', (e) => {
    searchQuery = e.target.value.toLowerCase();
    filterPosts();
  });

  tagCloud?.addEventListener('click', (e) => {
    const target = e.target;
    const tagEl = target.closest('.cloud-tag');
    if (tagEl) {
      const tag = tagEl.getAttribute('data-tag');
      if (tag) {
        toggleTag(tag);
      }
    }
  });

  postsList?.addEventListener('click', (e) => {
    const target = e.target;
    const tagEl = target.closest('.tag');
    if (tagEl) {
      e.preventDefault();
      const tag = tagEl.getAttribute('data-tag');
      if (tag) {
        toggleTag(tag);
      }
    }
  });

  activeFiltersContainer?.addEventListener('click', (e) => {
    const tag = e.target.getAttribute('data-tag');
    if (tag) {
      activeTags.delete(tag.toLowerCase());
      filterPosts();
    }
  });

  clearTagsBtn?.addEventListener('click', (e) => {
    e.preventDefault();
    clearAllTags();
  });
</script>
