      height: 20rem;
      max-height: none;
      overflow: hidden;
      cursor: grab;
      touch-action: none;
      user-select: none;
      mask-image: radial-gradient(ellipse 76% 82% at center, #000 58%, transparent 100%);
      -webkit-mask-image: radial-gradient(ellipse 76% 82% at center, #000 58%, transparent 100%);
    }

    .tag-cloud-list.is-dragging {
      cursor: grabbing;
    }

    .tag-cloud-list :global(.tag-cloud-scene) {
      position: absolute;
      inset: 0;
    }

    .cloud-tag {
      position: relative;
      padding: 0.36rem 0.62rem;
      background: rgba(20, 20, 20, 0.82);
      border: 1px solid rgba(226, 60, 62, 0.18);
      border-radius: 6px;
      color: #b8b8b8;
      cursor: pointer;
      transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease, opacity 0.2s ease;
