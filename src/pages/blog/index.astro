  </style>

  <div class="blog-header">
    <div class="blog-hero-art" aria-hidden="true">
      <img src="/site-assets/blog-hero-monkey-v3.jpg" alt="" width="1774" height="887" fetchpriority="high" />
    </div>
    <div class="container">
      <h1 class="blog-title">技术博客</h1>
      <p class="blog-subtitle">记录 AI Agent 工程实践、前端技术探索与个人思考</p>
    </div>
  </div>

  <div class="controls-section">
    <div class="search-box">
      <i class="fas fa-search search-icon"></i>
      <input
        type="text"
        id="searchInput"
        class="search-input"
        placeholder="搜索标题、描述或标签..."
        autocomplete="off"
      >
    </div>

    <div class="tag-cloud">
      <div class="tag-cloud-header">
        <span class="tag-cloud-title">
          标签云
          <span class="tag-cloud-hint">拖动探索，字号代表文章数量</span>
        </span>
        <button id="clearTags" class="clear-tags">清除筛选</button>
      </div>
      <div class="tag-cloud-list" id="tagCloud" aria-label="按标签筛选文章">
        {uniqueTags.map(({ tag, count }) => {
          const weight = getTagWeight(count);
          const size = 0.76 + weight * 0.64;
          const fontWeight = Math.round(480 + weight * 220);

          return (
            <button
              type="button"
              class="cloud-tag"
              data-tag={tag}
              data-count={count}
              aria-pressed="false"
              aria-label={`${tag}，${count} 篇文章`}
              style={`--tag-size:${size.toFixed(2)}rem;--tag-weight:${fontWeight}`}
            >
              {tag}<span class="cloud-tag-count" aria-hidden="true">{count}</span>
            </button>
          );
        })}
      </div>
    </div>
  </div>

  <div class="blog-content">
    <div class="results-info">
      <span class="results-count">
        找到 <strong id="resultsCount">{posts.length}</strong> 篇文章
      </span>
      <div class="active-filters" id="activeFilters"></div>
    </div>

    <div class="posts-list" id="postsList">
      {posts.map((post) => {
        const tagList = post.data.tags.map((t: string) => t.toLowerCase()).join('|||');
        return (
          <a
            href={`/blog/${post.slug}`}
            class="post-card"
            data-post-id={post.id}
            data-title={post.data.title.toLowerCase()}
            data-description={post.data.description.toLowerCase()}
            data-tag-list={tagList}
