---
interface Props {
  title?: string;
  description?: string;
}

const { title = '杨正武 - Harness 工程师', description = '设计与 AI 智能体的高效工程实践' } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="32x32" href="/monkey-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/monkey-16x16.png">
    <link rel="shortcut icon" href="/monket-snow2.ico">

    <title>{title}</title>
    <meta name="description" content={description} />
    <style is:global>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      :root {
        /* 黑金配色方案 - 专业简约 */
        --bg-primary: #0a0a0f;
        --bg-secondary: #141414;
        --bg-card: #1a1a1a;
        --bg-hover: #222;
        --text-primary: #f0f0f0;
        --text-secondary: #a0a0a0;
        --text-muted: #6b7280;
        --accent: #d4af37;
        --accent-hover: #f5c842;
        --border: #2a2a2a;
        --shadow: rgba(0, 0, 0, 0.1);
        --shadow-hover: rgba(0, 0, 0, 0.2);
        --gradient-gold: linear-gradient(135deg, #d4af37, #f5c842, #ffd700);
        --gradient-blue: linear-gradient(135deg, #667eea, #764ba2);
      }

      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        background: var(--bg-primary);
        color: var(--text-primary);
        line-height: 1.7;
        overflow-x: hidden;
      }

      .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 2rem;
      }

      a {
        color: var(--accent);
        text-decoration: none;
        transition: all 0.3s ease;
      }

      a:hover {
        color: var(--accent-hover);
      }

      .navbar {
        background: rgba(20, 20, 20, 0.95);
        backdrop-filter: blur(20px);
        border-bottom: 1px solid var(--accent);
        position: sticky;
        top: 0;
        z-index: 1000;
        padding: 1rem 0;
      }

      .navbar .container {
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .navbar-brand {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--text-primary);
        display: flex;
        align-items: center;
        gap: 0.75rem;
        text-decoration: none;
      }

      .navbar-logo {
        width: 32px;
        height: 32px;
        object-fit: contain;
        transition: transform 0.3s ease;
      }

      .navbar-brand:hover .navbar-logo {
        transform: rotate(10deg);
      }

      .navbar-brand span {
        color: var(--accent);
      }

      .navbar-nav {
        display: flex;
        gap: 2.5rem;
        list-style: none;
      }

      .navbar-nav a {
        color: var(--text-secondary);
        font-weight: 500;
        font-size: 0.95rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        position: relative;
        padding: 0.5rem 0;
      }

      .navbar-nav a::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 50%;
        width: 0;
        height: 2px;
        background: var(--accent);
        transform: translateX(-50%);
        transition: width 0.3s ease;
      }

      .navbar-nav a:hover {
        color: var(--accent);
      }

      .navbar-nav a:hover::after {
        width: 100%;
      }

      ::-webkit-scrollbar {
        width: 10px;
      }

      ::-webkit-scrollbar-track {
        background: var(--bg-secondary);
      }

      ::-webkit-scrollbar-thumb {
        background: var(--accent);
        border-radius: 5px;
      }

      ::-webkit-scrollbar-thumb:hover {
        background: var(--accent-hover);
      }

      ::selection {
        background: var(--accent);
        color: #0a0a0f;
      }

      html {
        scroll-behavior: smooth;
      }

      @media (max-width: 768px) {
        .container {
          padding: 0 1.5rem;
        }

        .navbar-nav {
          gap: 2rem;
        }

        .navbar-nav a {
          font-size: 0.9rem;
        }
      }
    </style>
  </head>
  <body>
    <nav class="navbar">
      <div class="container">
        <a href="/" class="navbar-brand">
          <img src="/monket-snow2.png" alt="Logo" class="navbar-logo">
          杨正武<span>.imcoders</span>
        </a>
        <ul class="navbar-nav">
          <li><a href="/">首页</a></li>
          <li><a href="/#about">核心理念</a></li>
          <li><a href="/#projects">代表作品</a></li>
          <li><a href="/#skills">技术领域</a></li>
          <li><a href="/blog">博客</a></li>
          <li><a href="/#contact">联系</a></li>
        </ul>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <footer style="background: var(--bg-primary); border-top: 1px solid var(--border); padding: 3rem 0; text-align: center; color: var(--text-secondary); margin-top: 5rem;">
      <div class="container">
        <p style="font-size: 0.85rem; opacity: 0.8;">© 2026 杨正武 · Harness 工程师</p>
      </div>
    </footer>
  </body>
</html>
