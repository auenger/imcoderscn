---
interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title = '杨正武 - Harness 工程师', description = '设计与 AI 智能体的高效工程实践', image } = Astro.props;
const site = (Astro.site?.toString() || 'https://imcoders.cn').replace(/\/$/, '');
const ogImage = image
  ? `${site}${image.startsWith('/') ? image : '/' + image}`
  : `${site}/og-default.png`;
const ogUrl = new URL(Astro.url.pathname, site).toString();
const WX_SIGN_URL = import.meta.env.WX_SIGN_URL || '/api/wx-sign';
---

<script is:inline>
  // 移动端菜单切换
  let menuOpen = false;

  function toggleMenu() {
    menuOpen = !menuOpen;
    const nav = document.querySelector('.navbar-nav');
    const hamburger = document.querySelector('.hamburger');
    const navbar = document.querySelector('.navbar');

    if (nav && hamburger && navbar) {
      nav.classList.toggle('active', menuOpen);
      hamburger.classList.toggle('active', menuOpen);
      navbar.classList.toggle('menu-open', menuOpen);
      // 防止背景滚动
      document.body.style.overflow = menuOpen ? 'hidden' : '';
    }
  }

  // 点击导航链接后关闭菜单
  document.addEventListener('DOMContentLoaded', () => {
    const navLinks = document.querySelectorAll('.navbar-nav a');
    navLinks.forEach(link => {
      link.addEventListener('click', () => {
        if (window.innerWidth <= 768) {
          menuOpen = false;
          const nav = document.querySelector('.navbar-nav');
          const hamburger = document.querySelector('.hamburger');
          const navbar = document.querySelector('.navbar');
          if (nav && hamburger && navbar) {
            nav.classList.remove('active');
            hamburger.classList.remove('active');
            navbar.classList.remove('menu-open');
            document.body.style.overflow = '';
          }
        }
      });
    });

    // 点击遮罩层关闭菜单
    const navbar = document.querySelector('.navbar');
    if (navbar) {
      navbar.addEventListener('click', (e) => {
        if (e.target === navbar && menuOpen) {
          toggleMenu();
        }
      });
    }
  });

  // 窗口大小变化时重置菜单状态
  window.addEventListener('resize', () => {
    if (window.innerWidth > 768) {
      menuOpen = false;
      const nav = document.querySelector('.navbar-nav');
      const hamburger = document.querySelector('.hamburger');
      const navbar = document.querySelector('.navbar');
      if (nav && hamburger && navbar) {
        nav.classList.remove('active');
        hamburger.classList.remove('active');
        navbar.classList.remove('menu-open');
        document.body.style.overflow = '';
      }
    }
  });

  window.toggleMenu = toggleMenu;
</script>

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="32x32" href="/monkey-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/monkey-16x16.png">
    <link rel="shortcut icon" href="/monket-snow2.ico">

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="杨正武 · imcoders" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- 微信 / 结构化数据 -->
    <meta itemprop="name" content={title} />
    <meta itemprop="description" content={description} />
    <meta itemprop="image" content={ogImage} />
    <style is:global>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      :root {
        /* 黑金配色方案 - 专业简约 */
        --bg-primary: #0a0a0f;
        --bg-secondary: #141414;
        --bg-card: #1a1a1a;
        --bg-hover: #222;
        --text-primary: #f0f0f0;
        --text-secondary: #a0a0a0;
        --text-muted: #6b7280;
        --accent: #d4af37;
        --accent-hover: #f5c842;
        --border: #2a2a2a;
        --shadow: rgba(0, 0, 0, 0.1);
        --shadow-hover: rgba(0, 0, 0, 0.2);
        --gradient-gold: linear-gradient(135deg, #d4af37, #f5c842, #ffd700);
        --gradient-blue: linear-gradient(135deg, #667eea, #764ba2);
      }

      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        background: var(--bg-primary);
        color: var(--text-primary);
        line-height: 1.7;
        overflow-x: hidden;
      }

      .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 2rem;
      }

      a {
        color: var(--accent);
        text-decoration: none;
        transition: all 0.3s ease;
      }

      a:hover {
        color: var(--accent-hover);
      }

      .navbar {
        background: rgba(20, 20, 20, 0.95);
        backdrop-filter: blur(20px);
        border-bottom: 1px solid var(--accent);
        position: sticky;
        top: 0;
        z-index: 1000;
        padding: 1rem 0;
      }

      .navbar .container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: relative;
      }

      .navbar-brand {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--text-primary);
        display: flex;
        align-items: center;
        gap: 0.75rem;
        text-decoration: none;
        z-index: 1002;
      }

      .navbar-logo {
        width: 32px;
        height: 32px;
        object-fit: contain;
        transition: transform 0.3s ease;
      }

      .navbar-brand:hover .navbar-logo {
        transform: rotate(10deg);
      }

      .navbar-brand span {
        color: var(--accent);
      }

      /* 汉堡菜单按钮 */
      .hamburger {
        display: none;
        flex-direction: column;
        justify-content: space-around;
        width: 28px;
        height: 24px;
        background: transparent;
        border: none;
        cursor: pointer;
        padding: 0;
        z-index: 1002;
      }

      .hamburger span {
        width: 100%;
        height: 2px;
        background: var(--accent);
        border-radius: 2px;
        transition: all 0.3s ease;
      }

      .hamburger.active span:nth-child(1) {
        transform: rotate(45deg) translate(5px, 5px);
      }

      .hamburger.active span:nth-child(2) {
        opacity: 0;
      }

      .hamburger.active span:nth-child(3) {
        transform: rotate(-45deg) translate(7px, -7px);
      }

      .navbar-nav {
        display: flex;
        gap: 2.5rem;
        list-style: none;
      }

      .navbar-nav a {
        color: var(--text-secondary);
        font-weight: 500;
        font-size: 0.95rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        position: relative;
        padding: 0.5rem 0;
      }

      .navbar-nav a::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 50%;
        width: 0;
        height: 2px;
        background: var(--accent);
        transform: translateX(-50%);
        transition: width 0.3s ease;
      }

      .navbar-nav a:hover {
        color: var(--accent);
      }

      .navbar-nav a:hover::after {
        width: 100%;
      }

      ::-webkit-scrollbar {
        width: 10px;
      }

      ::-webkit-scrollbar-track {
        background: var(--bg-secondary);
      }

      ::-webkit-scrollbar-thumb {
        background: var(--accent);
        border-radius: 5px;
      }

      ::-webkit-scrollbar-thumb:hover {
        background: var(--accent-hover);
      }

      ::selection {
        background: var(--accent);
        color: #0a0a0f;
      }

      html {
        scroll-behavior: smooth;
      }

      /* 响应式断点 */

      /* 手机和小平板（最大宽度 768px）- 使用汉堡菜单 */
      @media (max-width: 768px) {
        .container {
          padding: 0 1rem;
        }

        .navbar {
          padding: 0.75rem 0;
        }

        .navbar-brand {
          font-size: 1.2rem;
        }

        .navbar-logo {
          width: 28px;
          height: 28px;
        }

        /* 显示汉堡菜单按钮 */
        .hamburger {
          display: flex;
        }

        /* 移动端导航菜单样式 */
        .navbar-nav {
          position: fixed;
          top: 0;
          right: -100%;
          width: 70%;
          max-width: 280px;
          height: 100vh;
          background: rgba(20, 20, 20, 0.98);
          backdrop-filter: blur(20px);
          flex-direction: column;
          gap: 0;
          padding: 5rem 1.5rem 2rem;
          border-left: 1px solid var(--border);
          transition: right 0.3s ease;
          overflow-y: auto;
        }

        .navbar-nav.active {
          right: 0;
        }

        .navbar-nav li {
          width: 100%;
          border-bottom: 1px solid var(--border);
        }

        .navbar-nav a {
          display: block;
          width: 100%;
          padding: 1rem 0;
          font-size: 1rem;
        }

        .navbar-nav a::after {
          display: none;
        }

        .navbar-nav a:hover {
          color: var(--accent);
          background: rgba(212, 175, 55, 0.1);
          padding-left: 0.5rem;
        }

        /* 遮罩层 */
        .navbar::after {
          content: '';
          position: fixed;
          top: 0;
          left: 0;
          width: 100%;
          height: 100%;
          background: rgba(0, 0, 0, 0.6);
          opacity: 0;
          visibility: hidden;
          transition: all 0.3s ease;
          z-index: 1001;
        }

        .navbar.menu-open::after {
          opacity: 1;
          visibility: visible;
        }
      }

      /* 中小平板（769px - 1024px）- 简化导航 */
      @media (min-width: 769px) and (max-width: 1024px) {
        .container {
          padding: 0 1.5rem;
        }

        .navbar-brand {
          font-size: 1.3rem;
        }

        .navbar-nav {
          gap: 1.5rem;
        }

        .navbar-nav a {
          font-size: 0.85rem;
          padding: 0.4rem 0;
        }
      }

      /* 小屏幕电脑/大平板（1025px - 1280px）*/
      @media (min-width: 1025px) and (max-width: 1280px) {
        .container {
          max-width: 1100px;
        }
      }

      /* 超大屏幕（1281px+）*/
      @media (min-width: 1281px) {
        .container {
          max-width: 1400px;
        }
      }
    </style>

    <!-- 微信 JS-SDK：自定义“微信内打开网页后点分享”的卡片 -->
    <script is:inline src="https://res.wx.qq.com/open/js/jweixin-1.6.0.js"></script>
    <script is:inline define:vars={{ signUrl: WX_SIGN_URL, shareTitle: title, shareDesc: description, shareLink: ogUrl, shareImg: ogImage }}>
      (function () {
        if (!signUrl || typeof wx === 'undefined') return;
        var url = location.href.split('#')[0];
        fetch(signUrl + '?url=' + encodeURIComponent(url))
          .then(function (r) { return r.json(); })
          .then(function (d) {
            if (!d || !d.signature) return;
            wx.config({
              debug: false,
              appId: d.appId,
              timestamp: d.timestamp,
              nonceStr: d.nonceStr,
              signature: d.signature,
              jsApiList: ['updateAppMessageShareData', 'updateTimelineShareData']
            });
            wx.ready(function () {
              wx.updateAppMessageShareData({ title: shareTitle, desc: shareDesc, link: shareLink, imgUrl: shareImg });
              wx.updateTimelineShareData({ title: shareTitle, link: shareLink, imgUrl: shareImg });
            });
            wx.error(function (res) { console.warn('[wx-sign] config failed:', res && res.errMsg); });
          })
          .catch(function (e) { console.error('wx-sign failed', e); });
      })();
    </script>
  </head>
  <body>
    <nav class="navbar" id="navbar">
      <div class="container">
        <a href="/" class="navbar-brand">
          <img src="/monket-snow2.png" alt="Logo" class="navbar-logo">
          杨正武<span>.imcoders</span>
        </a>
        <button class="hamburger" onclick="toggleMenu()" aria-label="切换菜单">
          <span></span>
          <span></span>
          <span></span>
        </button>
        <ul class="navbar-nav">
          <li><a href="/">首页</a></li>
          <li><a href="/#about">核心理念</a></li>
          <li><a href="/#projects">代表作品</a></li>
          <li><a href="/#skills">技术领域</a></li>
          <li><a href="/blog">博客</a></li>
          <li><a href="/#contact">联系</a></li>
        </ul>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <footer style="background: var(--bg-primary); border-top: 1px solid var(--border); padding: 3rem 0; text-align: center; color: var(--text-secondary); margin-top: 5rem;">
      <div class="container">
        <p style="font-size: 0.85rem; opacity: 0.8;">© 2026 杨正武 · Harness 工程师</p>
      </div>
    </footer>
  </body>
</html>
