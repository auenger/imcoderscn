---
interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title = '杨正武 - Harness 工程师', description = '设计与 AI 智能体的高效工程实践', image } = Astro.props;
const site = (Astro.site?.toString() || 'https://imcoders.cn').replace(/\/$/, '');
const imagePath = image ? (image.startsWith('/') ? image : '/' + image) : '/og-default.png';
const ogImage = site + imagePath;
const ogUrl = new URL(Astro.url.pathname, site).toString();
const WX_SIGN_URL = import.meta.env.WX_SIGN_URL || '/api/wx-sign';
const pathname = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#111016" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="icon" type="image/png" sizes="32x32" href="/monkey-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/monkey-16x16.png" />
    <link rel="shortcut icon" href="/monket-snow2.ico" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="杨正武 · imcoders" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta itemprop="name" content={title} />
    <meta itemprop="description" content={description} />
    <meta itemprop="image" content={ogImage} />

    <style is:global>
      :root {
        --ink: #111016;
        --ink-soft: #191820;
        --paper: #f1ece2;
        --paper-soft: #e8e0d3;
        --red: #e23c3e;
        --red-deep: #bd2f33;
        --text-on-ink: #f1ece2;
        --text-on-paper: #17161c;
        --muted-on-ink: #aaa6ad;
        --muted-on-paper: #625f65;
        --line-on-ink: rgba(241, 236, 226, 0.16);
        --line-on-paper: rgba(23, 22, 28, 0.18);
        --radius: 14px;
        --display: "Arial Black", "Helvetica Neue", "PingFang SC", sans-serif;
        --sans: "Helvetica Neue", "PingFang SC", "Microsoft YaHei", system-ui, sans-serif;

        /* Backward-compatible tokens for legacy page styles. */
        --bg-primary: var(--ink);
        --bg-secondary: var(--ink-soft);
        --bg-card: var(--ink-soft);
        --bg-hover: #24222c;
        --text-primary: var(--text-on-ink);
        --text-secondary: var(--muted-on-ink);
        --text-muted: #77737d;
        --accent: var(--red);
        --accent-hover: #f05052;
        --border: var(--line-on-ink);
        --shadow: rgba(17, 16, 22, 0.12);
        --shadow-hover: rgba(17, 16, 22, 0.22);
      }

      *, *::before, *::after { box-sizing: border-box; }
      html { scroll-behavior: smooth; background: var(--ink); }
      body {
        margin: 0;
        min-width: 320px;
        overflow-x: hidden;
        background: var(--paper);
        color: var(--text-on-paper);
        font-family: var(--sans);
        line-height: 1.65;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
      }

      body::before {
        content: "";
        position: fixed;
        inset: 0;
        z-index: 20;
        pointer-events: none;
        opacity: 0.035;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.8'/%3E%3C/svg%3E");
      }

      h1, h2, h3, p, ul { margin-top: 0; }
      img { display: block; max-width: 100%; }
      button, input { font: inherit; }
      a { color: inherit; text-decoration: none; }
      ::selection { color: var(--paper); background: var(--red); }
      :focus-visible { outline: 2px solid var(--red); outline-offset: 4px; }

      .container {
        width: min(100% - 64px, 1240px);
        margin-inline: auto;
      }

      .site-nav {
        position: fixed;
        inset: 0 0 auto;
        z-index: 10;
        height: 72px;
        color: var(--text-on-ink);
        background: rgba(17, 16, 22, 0.9);
        border-bottom: 1px solid var(--line-on-ink);
        backdrop-filter: blur(18px) saturate(125%);
        -webkit-backdrop-filter: blur(18px) saturate(125%);
      }

      .site-nav-inner {
        width: min(100% - 64px, 1240px);
        height: 100%;
        margin-inline: auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 32px;
      }

      .site-brand {
        display: inline-flex;
        align-items: center;
        gap: 11px;
        flex: 0 0 auto;
        font-family: var(--display);
        font-size: 1.08rem;
        font-weight: 900;
        letter-spacing: -0.035em;
      }

      .site-brand img { width: 34px; height: 34px; object-fit: contain; }
      .site-brand b { color: var(--red); font-weight: 900; }

      .site-links {
        display: flex;
        align-items: center;
        gap: 28px;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .site-links a {
        position: relative;
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        color: var(--muted-on-ink);
        font-size: 0.86rem;
        font-weight: 650;
        transition: color 180ms ease;
      }

      .site-links a:hover,
      .site-links a[aria-current="page"] { color: var(--text-on-ink); }
      .site-links a[aria-current="page"]::after {
        content: "";
        position: absolute;
        right: 0;
        bottom: 5px;
        left: 0;
        height: 2px;
        background: var(--red);
      }

      .menu-toggle {
        display: none;
        width: 44px;
        height: 44px;
        padding: 11px 8px;
        border: 0;
        color: var(--text-on-ink);
        background: transparent;
        cursor: pointer;
      }

      .menu-toggle span {
        display: block;
        height: 2px;
        margin: 5px 0;
        background: currentColor;
        transition: transform 180ms ease, opacity 180ms ease;
      }

      .menu-toggle[aria-expanded="true"] span:first-child { transform: translateY(7px) rotate(45deg); }
      .menu-toggle[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
      .menu-toggle[aria-expanded="true"] span:last-child { transform: translateY(-7px) rotate(-45deg); }

      main { min-height: 70dvh; }

      .site-footer {
        position: relative;
        overflow: hidden;
        padding: 80px 0 28px;
        color: var(--text-on-ink);
        background: var(--ink);
      }

      .site-footer-inner {
        display: grid;
        grid-template-columns: 1.5fr 1fr;
        gap: 64px;
        align-items: end;
      }

      .site-footer-title {
        max-width: 680px;
        margin-bottom: 28px;
        font-family: var(--display);
        font-size: clamp(2.5rem, 5.8vw, 5.7rem);
        line-height: 0.92;
        letter-spacing: -0.07em;
      }

      .site-footer-title span { color: var(--red); }
      .site-footer-links { display: flex; flex-wrap: wrap; gap: 10px 24px; }
      .site-footer-links a { color: var(--muted-on-ink); font-size: 0.9rem; }
      .site-footer-links a:hover { color: var(--text-on-ink); }
      .site-footer-meta { color: var(--muted-on-ink); font-size: 0.82rem; text-align: right; }

      @media (max-width: 768px) {
        .container, .site-nav-inner { width: min(100% - 32px, 1240px); }
        .site-nav { height: 64px; }
        .site-brand { font-size: 0.98rem; }
        .site-brand img { width: 30px; height: 30px; }
        .menu-toggle { display: block; }
        .site-links {
          position: fixed;
          inset: 64px 0 auto;
          display: grid;
          gap: 0;
          padding: 12px 16px 20px;
          background: rgba(17, 16, 22, 0.98);
          border-bottom: 1px solid var(--line-on-ink);
          transform: translateY(-120%);
          visibility: hidden;
          transition: transform 220ms cubic-bezier(.16, 1, .3, 1), visibility 220ms;
        }

        .site-links.is-open { transform: translateY(0); visibility: visible; }
        .site-links a { min-height: 52px; border-bottom: 1px solid var(--line-on-ink); }
        .site-links li:last-child a { border-bottom: 0; }
        .site-links a[aria-current="page"]::after { display: none; }
        .site-footer { padding-top: 56px; }
        .site-footer-inner { grid-template-columns: 1fr; gap: 38px; }
        .site-footer-meta { text-align: left; }
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after { animation-duration: 0.001ms !important; animation-iteration-count: 1 !important; transition-duration: 0.001ms !important; }
      }
    </style>

    <script is:inline src="https://res.wx.qq.com/open/js/jweixin-1.6.0.js"></script>
    <script is:inline define:vars={{ signUrl: WX_SIGN_URL, shareTitle: title, shareDesc: description, shareLink: ogUrl, shareImg: ogImage }}>
      (function () {
        if (!signUrl || typeof wx === 'undefined') return;
        var url = location.href.split('#')[0];
        fetch(signUrl + '?url=' + encodeURIComponent(url))
          .then(function (r) { return r.json(); })
          .then(function (d) {
            if (!d || !d.signature) return;
            wx.config({ debug: false, appId: d.appId, timestamp: d.timestamp, nonceStr: d.nonceStr, signature: d.signature, jsApiList: ['updateAppMessageShareData', 'updateTimelineShareData'] });
            wx.ready(function () {
              wx.updateAppMessageShareData({ title: shareTitle, desc: shareDesc, link: shareLink, imgUrl: shareImg });
              wx.updateTimelineShareData({ title: shareTitle, link: shareLink, imgUrl: shareImg });
            });
          })
          .catch(function (error) { console.error('wx-sign failed', error); });
      })();
    </script>
  </head>
  <body>
    <nav class="site-nav" aria-label="主导航">
      <div class="site-nav-inner">
        <a href="/" class="site-brand" aria-label="杨正武个人站首页">
          <img src="/monket-snow2.png" alt="" />
          杨正武<b>/IMCODERS</b>
        </a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-links" aria-label="打开导航菜单">
          <span></span><span></span><span></span>
        </button>
        <ul class="site-links" id="site-links">
          <li><a href="/" aria-current={pathname === '/' ? 'page' : undefined}>首页</a></li>
          <li><a href="/#projects">作品</a></li>
          <li><a href="/blog" aria-current={pathname.startsWith('/blog') ? 'page' : undefined}>博客</a></li>
          <li><a href="/#contact">联系</a></li>
        </ul>
      </div>
    </nav>

    <main><slot /></main>

    <footer class="site-footer">
      <div class="container site-footer-inner">
        <div>
          <div class="site-footer-title">BUILD THE <span>HARNESS.</span></div>
          <div class="site-footer-links">
            <a href="https://github.com/auenger" target="_blank" rel="noopener noreferrer">GitHub</a>
            <a href="mailto:yzw@imcoders.net">Email</a>
            <a href="/blog">博客</a>
          </div>
        </div>
        <div class="site-footer-meta">© 2026 杨正武<br />Harness Engineer</div>
      </div>
    </footer>

    <script is:inline>
      const menuButton = document.querySelector('.menu-toggle');
      const menu = document.querySelector('.site-links');
      const closeMenu = () => {
        menuButton?.setAttribute('aria-expanded', 'false');
        menu?.classList.remove('is-open');
        document.body.style.overflow = '';
      };

      menuButton?.addEventListener('click', () => {
        const willOpen = menuButton.getAttribute('aria-expanded') !== 'true';
        menuButton.setAttribute('aria-expanded', String(willOpen));
        menu?.classList.toggle('is-open', willOpen);
        document.body.style.overflow = willOpen ? 'hidden' : '';
      });
      menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
      window.matchMedia('(min-width: 769px)').addEventListener('change', closeMenu);
    </script>
  </body>
</html>
